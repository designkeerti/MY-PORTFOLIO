{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keerti-portfolio",
  "compatibility_date": "2026-10-01",
  // only the films run through the worker (it adds byte ranges); everything else is static
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router handles routes client-side, so unknown paths serve index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/films/*"]
  }
}
