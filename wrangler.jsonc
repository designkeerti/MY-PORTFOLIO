{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keerti-portfolio",
  "compatibility_date": "2026-10-01",
  // only the films (byte ranges) and /api run through the worker; everything else is static
  "main": "./worker/index.js",
  // the job finder's open models (Workers AI), and a per-visitor limit on them
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router handles routes client-side, so unknown paths serve index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/films/*", "/api/*"]
  },
  // Cloudflare's Git builds deploy branches with `wrangler preview`, which needs this block
  // (empty: previews take everything above as it is)
  "previews": {}
}
