return null;
}
document.addEventListener('click',function(ev){
var el=ev.target,a=(el&&el.closest)?el.closest('a[href*="/product/"]'):null;
if(!a||typeof g.formatters.select_content!=='function')return;
var prod=byUrl(a.href);
if(!prod)return;
try{var p=g.formatters.select_content({product:prod});if(p)t('event','select_content',p);}catch(e){}
},true);
function nameFromDom(pid){
var b=document.querySelector('[data-product-id="'+pid+'"][aria-label]');
if(b){var s=b.getAttribute('aria-label')||'';s=s.replace(/^Add /,'').replace(/ to cart$/,'');if(s)return s;}
return 'Product '+pid;
}
function reportAdd(body){
