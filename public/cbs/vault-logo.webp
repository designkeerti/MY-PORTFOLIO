var qty=parseInt(q.quantity,10)||1;
var prod=byId(q.product_id);
var payload=null;
if(prod&&typeof g.formatters.add_to_cart==='function'){payload=g.formatters.add_to_cart({product:prod,quantity:qty});}
if(!payload){payload={items:[{item_id:String(q.variation_id||q.product_id),item_name:nameFromDom(q.product_id),quantity:qty}]};}
if(payload)t('event','add_to_cart',payload);
}catch(e){}
}
