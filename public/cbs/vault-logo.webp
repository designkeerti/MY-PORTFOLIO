for(i=0;i<MAP.length;i++){m=MAP[i];if(m.url&&(href.indexOf(m.url)===0||m.url.indexOf(href.split('#')[0].split('?')[0])===0)){return (g.data.products||[])[m.i];}}
return null;
}
