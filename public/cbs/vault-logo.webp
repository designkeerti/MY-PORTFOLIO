    <script id="cbs-unified-card-js">
    (function(){
        function bind(card){
            if (card.__cbsBound) return;
            card.__cbsBound = true;
            var btn = card.querySelector('.clck-click');
            if (!btn) return;
            btn.addEventListener('click', function(e){
                e.preventDefault();
                e.stopPropagation();
                card.classList.toggle('effectOn');
            });
            btn.addEventListener('keydown', function(e){
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    card.classList.toggle('effectOn');
                }
            });
        }
        function bindAll(){
            document.querySelectorAll('.product-card.effect1').forEach(bind);
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindAll);
        } else {
            bindAll();
        }
        /* Re-bind after slick or AJAX adds new cards */
        var mo = new MutationObserver(function(muts){
            for (var i = 0; i < muts.length; i++) {
                if (muts[i].addedNodes.length) { bindAll(); return; }
            }
        });
        mo.observe(document.body, { childList: true, subtree: true });
        /* Close popout when clicking outside */
        document.addEventListener('click', function(e){
            if (e.target.closest('.clck-click')) return;
            document.querySelectorAll('.product-card.effect1.effectOn').forEach(function(c){
                if (!c.contains(e.target)) c.classList.remove('effectOn');
            });
        });
    })();
    </script>
    <script>
/* CBS-TOAST-V1 - route all WooCommerce notices to small auto-dismissing bottom toasts. */
(function(){
	if (window.__cbsToastInit) { return; }
	window.__cbsToastInit = true;
	var SELECTOR = '.woocommerce-message, .woocommerce-error, .woocommerce-info, .custom-success-message';
	var wrap = null;
	function ensureWrap(){
		if (wrap && document.body.contains(wrap)) { return wrap; }
		wrap = document.createElement('div');
		wrap.className = 'cbs-toasts';
		wrap.setAttribute('aria-live', 'polite');
		document.body.appendChild(wrap);
		return wrap;
	}
	function toast(html, type){
		html = (html || '').toString().trim();
		if (!html) { return; }
		ensureWrap();
		var t = document.createElement('div');
		t.className = 'cbs-toast cbs-toast--' + (type || 'info');
		var msg = document.createElement('span');
		msg.className = 'cbs-toast__msg';
		msg.innerHTML = html;
		var x = document.createElement('button');
		x.type = 'button';
		x.className = 'cbs-toast__x';
		x.setAttribute('aria-label', 'Dismiss');
		x.innerHTML = '&times;';
		t.appendChild(msg);
		t.appendChild(x);
		t.style.transform = 'translateY(14px) scale(0.98)';
		wrap.appendChild(t);
		void t.offsetHeight;
		t.style.transform = 'translateY(0) scale(1)';
		var life = (type === 'error') ? 6500 : 3800;
		var timer = setTimeout(closeIt, life);
		function closeIt(){
			clearTimeout(timer);
			t.style.opacity = '0';
			t.style.transform = 'translateY(8px) scale(0.98)';
			setTimeout(function(){ if (t.parentNode) { t.parentNode.removeChild(t); } }, 380);
		}
		x.addEventListener('click', closeIt);
		t.addEventListener('mouseenter', function(){ clearTimeout(timer); });
		t.addEventListener('mouseleave', function(){ timer = setTimeout(closeIt, 1800); });
	}
	window.cbsToast = toast;
	function typeOf(el){
		if (el.classList.contains('woocommerce-error')) { return 'error'; }
		if (el.classList.contains('woocommerce-message')) { return 'success'; }
		if (el.classList.contains('custom-success-message')) { return 'success'; }
		return 'info';
	}
	function skip(el){
		if (el.__cbsDone) { return true; }
		if (el.classList.contains('cart-empty')) { return true; }
		if (el.closest && el.closest('.cbs-cart--empty')) { return true; }
		var txt = (el.textContent || '').toLowerCase();
		if (txt.indexOf('cart is currently empty') > -1) { return true; }
		if (txt.indexOf('cart updated') > -1) { return true; }
		return false;
	}
	function harvest(el){
		if (!el || el.nodeType !== 1) { return; }
		if (skip(el)) { el.__cbsDone = true; return; }
		el.__cbsDone = true;
		var type = typeOf(el);
		var lis = el.querySelectorAll('li');
		if (lis.length) {
			for (var i = 0; i < lis.length; i++) { toast(lis[i].innerHTML, type); }
		} else {
			toast(el.innerHTML, type);
		}
		if (el.parentNode) { el.parentNode.removeChild(el); }
	}
	function scan(root){
		if (!root || !root.querySelectorAll) { return; }
		var nodes = root.querySelectorAll(SELECTOR);
		for (var i = 0; i < nodes.length; i++) { harvest(nodes[i]); }
	}
	function start(){
		scan(document);
		var mo = new MutationObserver(function(muts){
			for (var i = 0; i < muts.length; i++) {
				var added = muts[i].addedNodes;
				for (var j = 0; j < added.length; j++) {
					var n = added[j];
					if (n.nodeType !== 1) { continue; }
					if (n.matches && n.matches(SELECTOR)) { harvest(n); }
					else { scan(n); }
				}
			}
		});
		mo.observe(document.body, { childList: true, subtree: true });
		if (window.jQuery) {
			jQuery(document.body).on('added_to_cart', function(){ toast('Added to cart.', 'success'); });
		}
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
})();
</script>

