    <style id="cbs-unified-card-css">
    /* ===== UNIFIED PRODUCT CARD (scoped to .product-card only) ===== */
    .product-card.effect1,
    ul.products li.product.product-card.effect1,
    .products li.product.product-card.effect1 {
        position: relative;
        display: flex;
        flex-direction: column;
        background: #161616;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        overflow: hidden;
        padding: 0;
        margin: 0;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        list-style: none;
    }
    .product-card.effect1:hover {
        transform: translateY(-3px);
        border-color: rgba(58,143,181,0.45);
        box-shadow: 0 12px 28px rgba(0,0,0,0.45);
    }

    /* Cursor (quick-view) button — top-right */
    .product-card.effect1 .clck-click {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 5;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #1a6ffa;
        color: #fff;
        border-radius: 50%;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(26,111,250,0.35);
        transition: transform 0.2s ease, background 0.2s ease;
        user-select: none;
    }
    .product-card.effect1 .clck-click:hover {
        transform: scale(1.08);
        background: #2178ff;
    }
    .product-card.effect1 .clck-click i {
        font-size: 18px;
        line-height: 1;
    }
    .product-card.effect1.effectOn .clck-click {
        background: #22c55e;
        box-shadow: 0 4px 10px rgba(34,197,94,0.4);
    }

    /* Image area */
    .product-card.effect1 .product-image {
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .product-card.effect1 .imb-bx {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #1c1c1c;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-card.effect1 .imb-bx .cbs-img-link {
        display: flex;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }
    .product-card.effect1 .imb-bx img {
        max-width: 86%;
        max-height: 86%;
        object-fit: contain;
        transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;
    }
    /* Image rotation effect on .effectOn handled by site theme (existing peek/tilt) */

    /* Out-of-stock badge */
    .product-card.effect1 .cbs-stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(220, 38, 38, 0.92);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 4px 10px;
        border-radius: 999px;
        z-index: 4;
    }

    /* Pop-out short-description (attribute pills) */
    .product-card.effect1 .short-description {
        position: absolute;
        inset: 0;
        background: rgba(15,15,15,0.86);
        backdrop-filter: blur(4px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        pointer-events: none;
        z-index: 3;
    }
    .product-card.effect1.effectOn .short-description {
        opacity: 1;
        visibility: visible;
    }
    .product-card.effect1 .short-description ul,
    .product-card.effect1 .short-description-text ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
    }
    .product-card.effect1 .short-description li {
        background: rgba(26,111,250,0.14);
        border: 1px solid rgba(26,111,250,0.45);
        color: #e8f1ff;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
        transform: translateX(-12px);
        opacity: 0;
        transition: transform 0.4s ease, opacity 0.4s ease;
    }
    .product-card.effect1.effectOn .short-description li {
        transform: translateX(0);
        opacity: 1;
    }
    .product-card.effect1.effectOn .short-description li:nth-child(1) { transition-delay: 0.05s; }
    .product-card.effect1.effectOn .short-description li:nth-child(2) { transition-delay: 0.12s; }
    .product-card.effect1.effectOn .short-description li:nth-child(3) { transition-delay: 0.19s; }
    .product-card.effect1.effectOn .short-description li:nth-child(4) { transition-delay: 0.26s; }
    .product-card.effect1.effectOn .short-description li:nth-child(5) { transition-delay: 0.33s; }
    .product-card.effect1 .short-description li strong {
        font-weight: 700;
    }
    .product-card.effect1 .short-description-text {
        width: 100%;
    }

    /* Product info (below image) */
    .product-card.effect1 .product-info {
        padding: 14px 14px 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .product-card.effect1 .product-title-wrapper {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        justify-content: space-between;
    }
    .product-card.effect1 .product-title {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.3;
        color: #ffffff;
        flex: 1;
        min-width: 0;
    }
    .product-card.effect1 .product-title a {
        color: inherit;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: normal;
        text-overflow: clip;
        word-break: break-word;
    }
    .product-card.effect1 .product-title a:hover {
        color: #3a8fb5;
    }

    /* Wishlist heart */
    .product-card.effect1 .wishlist-container {
        flex-shrink: 0;
        display: flex;
        align-items: center;
    }
    .product-card.effect1 .wishlist-container a,
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button {
        background: transparent !important;
        border: none !important;
        padding: 4px !important;
        margin: 0 !important;
        color: #888 !important;
        font-size: 0;
        line-height: 1 !important;
        text-decoration: none !important;
        min-width: 0 !important;
        min-height: 0 !important;
        box-shadow: none !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease, transform 0.15s ease;
    }
    .product-card.effect1 .wishlist-container a:hover,
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button:hover {
        color: #ef4444 !important;
        transform: scale(1.12);
    }
    .product-card.effect1 .wishlist-container i,
    .product-card.effect1 .wishlist-container svg {
        font-size: 18px !important;
        width: 18px !important;
        height: 18px !important;
        line-height: 1 !important;
    }
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button--added,
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button--added i,
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button--added svg {
        color: #ef4444 !important;
        fill: #ef4444 !important;
    }
    .product-card.effect1 .wishlist-container .yith-wcwl-add-to-wishlist-button__label,
    .product-card.effect1 .wishlist-container .feedback {
        display: none !important;
    }

    /* Backward compat for existing shortcode cards (.product-card.effect1 .rating with raw 0 + 64px SVG) */
    .product-card.effect1 .rating {
        display: flex !important;
        align-items: center;
        gap: 4px;
        font-size: 12px !important;
        font-weight: 600;
        color: #888;
        line-height: 1;
    }
    .product-card.effect1 .rating svg {
        width: 14px !important;
        height: 14px !important;
        flex-shrink: 0;
    }
    .product-card.effect1 .rating svg path { fill: #f59e0b !important; stroke: none !important; }

    /* Backward compat for the older yith heart anchor structure */
    .product-card.effect1 .yith-wcwl-add-button .add_to_wishlist {
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: 0 !important;
        line-height: 1 !important;
        text-decoration: none !important;
    }
    .product-card.effect1 .yith-wcwl-add-button .add_to_wishlist i.fa-heart,
    .product-card.effect1 .yith-wcwl-add-button .add_to_wishlist i.fa-heart-o {
        font-size: 18px !important;
        color: #888 !important;
        line-height: 1 !important;
        transition: color 0.15s ease, transform 0.15s ease;
    }
    .product-card.effect1 .yith-wcwl-add-button .add_to_wishlist:hover i {
        color: #ef4444 !important;
        transform: scale(1.12);
    }
    .product-card.effect1 .yith-wcwl-add-button .add_to_wishlist i.fa-heart {
        color: #ef4444 !important;
    }

    /* Star rating */
    .product-card.effect1 .cbs-rating {
        display: flex;
        align-items: center;
        gap: 2px;
        color: #2c2c2c;
    }
    .product-card.effect1 .cbs-rating .cbs-star { color: #2c2c2c; display: inline-flex; }
    .product-card.effect1 .cbs-rating .cbs-star--on { color: #f59e0b; }
    .product-card.effect1 .cbs-rating .cbs-rating-value {
        font-size: 11px;
        font-weight: 600;
        color: #888;
        margin-left: 4px;
    }

    /* Price */
    .product-card.effect1 .product-price {
        display: flex;
        align-items: baseline;
        gap: 4px;
        flex-wrap: wrap;
        font-weight: 700;
        font-size: 15px;
        color: #3a8fb5;
        margin-top: 2px;
    }
    .product-card.effect1 .product-price .srt-frm {
        font-size: 11px;
        font-weight: 500;
        color: #888;
        margin-right: 2px;
    }
    .product-card.effect1 .product-price del {
        color: #666;
        font-weight: 400;
        font-size: 13px;
    }
    .product-card.effect1 .product-price ins {
        text-decoration: none;
        background: transparent;
    }
    .product-card.effect1 .product-price .woocommerce-Price-amount {
        color: inherit;
    }

    /* Action button */
    .product-card.effect1 .product-actions {
        padding: 0 14px 14px;
        margin-top: auto;
    }
    .product-card.effect1 .select-options,
    .product-card.effect1 .add-to-cart-btn,
    .product-card.effect1 .product-actions a,
    .product-card.effect1 .product-actions button,
    .product-card.effect1 a.add-to-cart,
    .product-card.effect1 a.add_to_cart_button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: #1a6ffa;
        color: #ffffff !important;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 10px 14px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.18s ease, transform 0.18s ease;
        line-height: 1.2;
    }
    .product-card.effect1 .select-options:hover,
    .product-card.effect1 .add-to-cart-btn:hover,
    .product-card.effect1 .product-actions a:hover,
    .product-card.effect1 .product-actions button:hover,
    .product-card.effect1 a.add-to-cart:hover,
    .product-card.effect1 a.add_to_cart_button:hover {
        background: #2178ff;
        transform: translateY(-1px);
        color: #ffffff !important;
    }
    .product-card.effect1 .select-options.out-of-stock {
        background: #2c2c2c;
        color: #666 !important;
        cursor: not-allowed;
    }

    /* Hide WC default loop elements that the override might leak */
    ul.products li.product.product-card.effect1 > a.woocommerce-LoopProduct-link:not(.cbs-img-link),
    ul.products li.product.product-card.effect1 > .product-wish,
    ul.products li.product.product-card.effect1 > h2.woocommerce-loop-product__title,
    ul.products li.product.product-card.effect1 > .price:not(.product-price),
    ul.products li.product.product-card.effect1 > a.button:not(.select-options):not(.add-to-cart-btn),
    ul.products li.product.product-card.effect1 > span.screen-reader-text {
        display: none !important;
    }

    /* Responsive: shop archive grid */
    ul.products {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 16px !important;
        list-style: none;
        padding-left: 0 !important;
        margin: 0 !important;
    }
    ul.products li.product {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        flex: 1 1 auto !important;
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
        display: block !important;
        float: none !important;
        clear: none !important;
    }
    ul.products::before,
    ul.products::after {
        display: none !important;
        content: none !important;
    }
    ul.products li.product > .product-card.effect1 {
        width: 100%;
        height: 100%;
    }
    @media (max-width: 991px) {
        ul.products { grid-template-columns: repeat(3, 1fr) !important; }
    }
    @media (max-width: 700px) {
        ul.products { grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; }
        .product-card.effect1 .product-title { font-size: 13px; }
        .product-card.effect1 .product-info { padding: 10px 10px 6px; }
        .product-card.effect1 .product-actions { padding: 0 10px 10px; }
    }
    </style>
    		<style id="wp-custom-css">
			/*
=======================================================
  Wishlist Page – Layout & Style (YITH WooCommerce Wishlist)
=======================================================*/

/* — Grid: 3 cols desktop, 1 col mobile — */
.yith-wcwl-form .wishlist_table {
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  gap: 10px !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
}

/* — CARD: CSS Grid layout — */
.yith-wcwl-form .wishlist_table li[data-row-id] {
  width: 100% !important;
  padding: 12px !important;
  margin: 0 !important;
  border-radius: 12px !important;
  overflow: visible !important;
  list-style: none !important;
  border: 1px solid rgba(255,255,255,0.06) !important;
  background: rgba(255,255,255,0.03) !important;
  box-sizing: border-box !important;

  display: grid !important;
  grid-template-columns: 80px 1fr auto !important;
  grid-template-rows: auto auto auto !important;
  gap: 4px 10px !important;
  align-items: start !important;
}

/* — Image: spans all 3 rows in column 1 — */
.yith-wcwl-form .wishlist_table li[data-row-id] .item-wrapper {
  display: contents !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-thumbnail {
  grid-column: 1 !important;
  grid-row: 1 / 4 !important;
  align-self: start !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-thumbnail img {
  width: 80px !important;
  height: 80px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  display: block !important;
}

/* — Name + Price: column 2-3, row 1 — */
.yith-wcwl-form .wishlist_table li[data-row-id] .item-details {
  grid-column: 2 / 4 !important;
  grid-row: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 2px !important;
  min-width: 0 !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-name h3 {
  font-size: 0.9rem !important;
  font-weight: 600 !important;
  margin: 0 !important;
  white-space: normal !important;
  overflow: visible !important;
  text-overflow: unset !important;
  line-height: 1.3 !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-name h3 a {
  color: inherit !important;
  text-decoration: none !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .item-details-table {
  margin: 0 !important;
  width: 100% !important;
  border: none !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .item-details-table td {
  padding: 0 4px 0 0 !important;
  font-size: 0.85rem !important;
  border: none !important;
  white-space: nowrap !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .item-details-table td.label {
  color: rgba(255,255,255,0.5) !important;
  width: auto !important;
}

/* — Additional info wrapper: use display contents to let children be grid items — */
.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info-wrapper {
  display: contents !important;
}

/* — Stock: column 2-3, row 2 — */
.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info {
  grid-column: 2 / 4 !important;
  grid-row: 2 !important;
  margin: 0 !important;
  width: auto !important;
  border: none !important;
  display: block !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info tbody,
.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info tr {
  display: block !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info td {
  display: inline !important;
  padding: 0 4px 0 0 !important;
  font-size: 0.8rem !important;
  border: none !important;
  white-space: nowrap !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .additional-info td.label {
  display: none !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .wishlist-in-stock {
  color: #4caf50 !important;
  font-weight: 600 !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .wishlist-out-of-stock {
  color: #f44336 !important;
  font-weight: 600 !important;
}

/* — Add to Cart button: column 2, row 3 — */
.yith-wcwl-form .wishlist_table li[data-row-id] .product-add-to-cart {
  grid-column: 2 !important;
  grid-row: 3 !important;
  display: flex !important;
  align-items: center !important;
  margin: 4px 0 0 0 !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-add-to-cart a {
  display: block !important;
  width: 100% !important;
  padding: 7px 10px !important;
  border-radius: 8px !important;
  font-size: 0.78rem !important;
  font-weight: 600 !important;
  text-align: center !important;
  background: #00bcd4 !important;
  color: #fff !important;
  text-decoration: none !important;
  white-space: nowrap !important;
}

/* — Remove/Trash button: column 3, row 3 — */
.yith-wcwl-form .wishlist_table li[data-row-id] .product-remove {
  grid-column: 3 !important;
  grid-row: 3 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 4px 0 0 0 !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-remove a {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 34px !important;
  height: 34px !important;
  border-radius: 8px !important;
  background: rgba(255,255,255,0.08) !important;
  color: rgba(255,255,255,0.7) !important;
  text-decoration: none !important;
  font-size: 0.85rem !important;
}

.yith-wcwl-form .wishlist_table li[data-row-id] .product-remove a:hover {
  background: rgba(244,67,54,0.2) !important;
  color: #f44336 !important;
}

/* — Out of stock: disable add to cart button — */
.yith-wcwl-form .wishlist_table li[data-row-id]:has(.wishlist-out-of-stock) .product-add-to-cart {
  opacity: 0.4 !important;
  pointer-events: none !important;
  filter: grayscale(60%) !important;
}

/* — Mobile: 1 col — */
@media (max-width: 599px) {
  .yith-wcwl-form .wishlist_table li[data-row-id] {
    width: 100% !important;
  }
}

/* =====================================================
   Wishlist Page – Desktop Table Layout Override (>599px)
   Makes the table-based desktop layout look like 3-col cards
   ===================================================== */

@media (min-width: 600px) {

  /* Hide the table header */
  .yith-wcwl-form table.wishlist_table thead {
    display: none !important;
  }

  /* Make table act as a flex wrapper */
  .yith-wcwl-form table.wishlist_table {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 12px !important;
    width: 100% !important;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  /* Make tbody act as full-width flex row container */
  .yith-wcwl-form table.wishlist_table tbody.wishlist-items-wrapper {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 12px !important;
    width: 100% !important;
    background: transparent !important;
  }

  /* Each TR = 1 card, CSS grid layout */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] {
    display: grid !important;
    grid-template-columns: 90px 1fr auto !important;
    grid-template-rows: auto auto auto auto !important;
    gap: 4px 12px !important;
    align-items: start !important;
    width: calc(33.333% - 8px) !important;
    box-sizing: border-box !important;
    padding: 14px !important;
    border-radius: 12px !important;
    border: 1px solid rgba(255,255,255,0.08) !important;
    background: rgba(255,255,255,0.04) !important;
  }

  /* Remove dark background from ALL td cells */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  /* Thumbnail: col 1, spans all 4 rows */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-thumbnail {
    grid-column: 1 !important;
    grid-row: 1 / 5 !important;
    align-self: start !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-thumbnail a {
    display: block !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-thumbnail img {
    width: 90px !important;
    height: 90px !important;
    object-fit: cover !important;
    border-radius: 8px !important;
    display: block !important;
  }

  /* Name: col 2-3, row 1 */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-name {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    overflow: visible !important;
    white-space: normal !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-name a {
    color: inherit !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: unset !important;
    display: block !important;
  }

  /* Price: col 2-3, row 2 */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-price {
    grid-column: 2 / 4 !important;
    grid-row: 2 !important;
    font-size: 0.88rem !important;
    color: rgba(255,255,255,0.75) !important;
    line-height: 1.3 !important;
  }

  /* Stock: col 2-3, row 3 */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-stock-status {
    grid-column: 2 / 4 !important;
    grid-row: 3 !important;
    font-size: 0.82rem !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-stock-status .wishlist-in-stock {
    color: #4caf50 !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-stock-status .wishlist-out-of-stock {
    color: #f44336 !important;
  }

  /* Add to cart: col 2, row 4 */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-add-to-cart {
    grid-column: 2 !important;
    grid-row: 4 !important;
    padding-top: 6px !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-add-to-cart a,
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-add-to-cart button {
    display: block !important;
    width: 100% !important;
    padding: 8px 12px !important;
    border-radius: 8px !important;
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    text-align: center !important;
    background: #1a9eb0 !important;
    color: #fff !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    border: none !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
  }

  /* Remove/Trash: col 3, row 4 */
  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-remove {
    grid-column: 3 !important;
    grid-row: 4 !important;
    padding-top: 6px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-remove a {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 8px !important;
    background: rgba(255,255,255,0.08) !important;
    color: rgba(255,255,255,0.6) !important;
    text-decoration: none !important;
    font-size: 0.85rem !important;
    transition: background 0.2s !important;
  }

  .yith-wcwl-form table.wishlist_table tr[data-row-id] td.product-remove a:hover {
    background: rgba(244,67,54,0.2) !important;
    color: #f44336 !important;
  }

  /* Out of stock: disable add to cart */
  .yith-wcwl-form table.wishlist_table tr[data-row-id]:has(.wishlist-out-of-stock) td.product-add-to-cart {
    opacity: 0.4 !important;
    pointer-events: none !important;
    filter: grayscale(60%) !important;
  }
}


/* ==========================================================
   CBS Phase 1 — Step 1: :root brand tokens + body color fix
   Destination: Customize → Additional CSS
   Date: 2026-04-25
   ========================================================== */

/* 1. :root brand token block */
:root {
  /* Brand cyan — primary confirmed as live CTA value */
  --cbs-cyan-100:    #1F92BF;   /* primary brand cyan — CTAs, icons */
  --cbs-cyan-200:    #186E90;   /* mid — hover/stroke, secondary state */
  --cbs-cyan-300:    #0F4E67;   /* deep — pressed/dark variant */
  --cbs-cyan-shadow: #05171F;   /* tinted dark panel hint */

  /* Surfaces */
  --cbs-bg-page:     #1A1A1A;   /* body background */
  --cbs-bg-section:  #000000;   /* section blocks */
  --cbs-bg-card:     #242424;   /* product card body */
  --cbs-border-card: #353535;   /* card outline */

  /* Text */
  --cbs-text-primary:       #FFFFFF;
  --cbs-text-heading-muted: #A3A3A3;
  --cbs-text-secondary:     #AAAAAA;
  --cbs-text-tertiary:      #818181;

  /* Status accents */
  --cbs-warning: #FFBC00;   /* rating star */
  --cbs-success: #0AE674;   /* in-stock indicator */
}

/* 2. Body color base fix
   Corrects body { color: #404040 } → readable #E8E8E8 on dark bg.
   High specificity prefix so plugin-output text inherits correctly.
   Safari: body.theme-cbs prefix forces specificity without !important. */
body.theme-cbs {
  color: #E8E8E8;
}

/* ==============================================================
   CBS Phase 1 — Steps 3–10: Full Home Page Polish
   Date: 2026-04-25
   ============================================================== */

/* 3. Polished preloader — brand-cyan dual-arc spinner on #0A0A0A
   CSS fail-safe: cannot block page beyond 4s even if JS fails    */
body.theme-cbs #preloader {
  background: #0A0A0A !important;
}
body.theme-cbs #preloader .loader,
body.theme-cbs #preloader span.loader {
  width: 52px !important;
  height: 52px !important;
  border: 3px solid rgba(31,146,191,0.18) !important;
  border-top-color: var(--cbs-cyan-100) !important;
  border-left-color: var(--cbs-cyan-200) !important;
  border-radius: 50% !important;
  animation: cbs-spin 0.85s linear infinite !important;
}
@keyframes cbs-spin { to { transform: rotate(360deg); } }
body.theme-cbs #preloader {
  animation: cbs-preloader-out 0.35s ease forwards;
  animation-delay: 4s;
  animation-fill-mode: forwards;
}
@keyframes cbs-preloader-out {
  from { opacity: 1; visibility: visible; }
  to   { opacity: 0; visibility: hidden; pointer-events: none; }
}

/* 4. Section H2 standardization — white + 4px cyan left-bar
   Size 16px / weight 700 / uppercase all unchanged               */
body.theme-cbs h2.mini-title { color: var(--cbs-text-primary) !important; padding-left: 14px !important; position: relative !important; }
body.theme-cbs h2.mini-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  -webkit-transform: translateY(-50%);
  transform: translateY(-50%);
  width: 4px;
  height: 0.85em;
  background: var(--cbs-cyan-100);
  border-radius: 2px;
}

/* 5. Slick dots + arrows — minimal restyle */

/* --- Dots: small, minimal --- */
body.theme-cbs .slick-dots li,
.products-grid .slick-dots li {
  width: 8px !important;
  height: 8px !important;
  margin: 0 4px !important;
  display: inline-block !important;
  vertical-align: middle !important;
}
body.theme-cbs .slick-dots li button,
.products-grid .slick-dots li button {
  width: 8px !important;
  height: 8px !important;
  border-radius: 50% !important;
  background: rgba(255,255,255,0.2) !important;
  border: none !important;
  padding: 0 !important;
  opacity: 1 !important;
  display: block !important;
  -webkit-transition: background 0.2s ease, -webkit-transform 0.2s ease;
  transition: background 0.2s ease, transform 0.2s ease;
}
body.theme-cbs .slick-dots li button::before,
.products-grid .slick-dots li button::before {
  display: none !important;
}
body.theme-cbs .slick-dots li.slick-active button,
.products-grid .slick-dots li.slick-active button {
  background: rgba(255,255,255,0.85) !important;
  -webkit-transform: scale(1.4);
  transform: scale(1.4);
}

/* --- Nav arrows: minimal neutral --- */
body.theme-cbs .slick-prev,
body.theme-cbs .slick-next {
  width: 36px !important;
  height: 36px !important;
  border-radius: 50% !important;
  background: transparent !important;
  border: 1.5px solid rgba(255,255,255,0.3) !important;
  box-shadow: none !important;
  -webkit-transition: border-color 0.2s ease, background 0.2s ease;
  transition: border-color 0.2s ease, background 0.2s ease;
}
body.theme-cbs .slick-prev:hover,
body.theme-cbs .slick-next:hover {
  background: rgba(255,255,255,0.08) !important;
  border-color: rgba(255,255,255,0.6) !important;
  box-shadow: none !important;
  -webkit-transform: none !important;
  transform: none !important;
}
body.theme-cbs .slick-prev::before,
body.theme-cbs .slick-next::before {
  color: rgba(255,255,255,0.7) !important;
  font-size: 14px !important;
  opacity: 1 !important;
}
body.theme-cbs .slick-prev:hover::before,
body.theme-cbs .slick-next:hover::before {
  color: #ffffff !important;
}

/* --- Hide nav arrows on CBS Athletes slider --- */
.thleat-box-main .slick-prev,
.thleat-box-main .slick-next {
  display: none !important;
}

/* 6. Shop Now / Select Options — hover / focus / disabled */
body.theme-cbs .shop-now-btn {
  border: 2px solid rgba(255,255,255,0.9) !important;
  box-shadow: 0 2px 14px rgba(0,0,0,0.5) !important;
  -webkit-transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}
body.theme-cbs .shop-now-btn:hover {
  background: var(--cbs-cyan-100) !important;
  border-color: var(--cbs-cyan-100) !important;
  color: #ffffff !important;
  box-shadow: 0 4px 20px rgba(31,146,191,0.4) !important;
}
body.theme-cbs .shop-now-btn:focus-visible {
  outline: 2px solid var(--cbs-cyan-100);
  outline-offset: 3px;
}
body.theme-cbs a.select-options,
body.theme-cbs a.add_to_cart_button,
body.theme-cbs button.single_add_to_cart_button {
  background: var(--cbs-cyan-100) !important;
  color: #ffffff !important;
  font-weight: 700 !important;
  -webkit-transition: background 0.2s ease, -webkit-transform 0.15s ease;
  transition: background 0.2s ease, transform 0.15s ease;
  -webkit-tap-highlight-color: transparent;
  cursor: pointer !important;
}
body.theme-cbs a.select-options:hover,
body.theme-cbs a.add_to_cart_button:hover,
body.theme-cbs button.single_add_to_cart_button:hover {
  background: var(--cbs-cyan-200) !important;
  -webkit-transform: translateY(-1px);
  transform: translateY(-1px);
}
body.theme-cbs a.select-options:active,
body.theme-cbs a.add_to_cart_button:active,
body.theme-cbs button.single_add_to_cart_button:active {
  background: var(--cbs-cyan-300) !important;
  -webkit-transform: translateY(0);
  transform: translateY(0);
}
body.theme-cbs a.select-options:focus-visible,
body.theme-cbs a.add_to_cart_button:focus-visible,
body.theme-cbs button.single_add_to_cart_button:focus-visible {
  outline: 2px solid var(--cbs-cyan-100);
  outline-offset: 3px;
}
body.theme-cbs a.select-options[disabled],
body.theme-cbs a.add_to_cart_button[disabled],
body.theme-cbs button.single_add_to_cart_button[disabled] {
  background: var(--cbs-border-card) !important;
  color: var(--cbs-text-tertiary) !important;
  cursor: not-allowed !important;
  opacity: 0.55;
  -webkit-transform: none !important;
  transform: none !important;
}

/* 7. Search bar placeholder + focus ring */
body.theme-cbs .product-search-input::-webkit-input-placeholder,
body.theme-cbs input[type="search"]::-webkit-input-placeholder { color: rgba(255,255,255,0.55) !important; }
body.theme-cbs .product-search-input::-moz-placeholder,
body.theme-cbs input[type="search"]::-moz-placeholder           { color: rgba(255,255,255,0.55) !important; }
body.theme-cbs .product-search-input::placeholder,
body.theme-cbs input[type="search"]::placeholder                 { color: rgba(255,255,255,0.55) !important; }
body.theme-cbs .product-search-input:focus,
body.theme-cbs input[type="search"]:focus {
  outline: 2px solid var(--cbs-cyan-100) !important;
  outline-offset: 2px;
  box-shadow: 0 0 0 4px rgba(31,146,191,0.15) !important;
}
body.theme-cbs input[type="search"] { -webkit-appearance: none; }

/* 8. Product card border + hover glow + .clck-click 44x44 touch target
   SACRED: no changes to position/display/transform/transition on
   .clck-click or .short-description — JS interaction preserved   */
body.theme-cbs .product-card {
  border: 2px solid var(--cbs-border-card) !important;
  border-radius: 12px !important;
  -webkit-transition: border-color 0.25s ease, box-shadow 0.25s ease;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}
body.theme-cbs .product-card:hover {
  border-color: var(--cbs-cyan-100) !important;
  box-shadow: 0 6px 28px rgba(31,146,191,0.14);
}
body.theme-cbs .clck-click { -webkit-tap-highlight-color: transparent; cursor: pointer; }
body.theme-cbs .clck-click::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 44px;
  height: 44px;
  -webkit-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%);
}

/* 9. Out-of-stock global rule — frontend-only, no query change */
body.theme-cbs .product-card.outofstock,
body.theme-cbs li.product.outofstock {
  opacity: 0.55;
  -webkit-filter: grayscale(0.85);
  filter: grayscale(0.85);
  order: 1;
}
body.theme-cbs .product-card.outofstock .product-price,
body.theme-cbs li.product.outofstock .price {
  text-decoration: line-through;
  opacity: 0.7;
}
body.theme-cbs .product-card.outofstock::after {
  content: "Out of Stock";
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0,0,0,0.78);
  color: var(--cbs-text-secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid var(--cbs-border-card);
  pointer-events: none;
  z-index: 2;
}
body.theme-cbs .product-card.outofstock [disabled],
body.theme-cbs li.product.outofstock [disabled] {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

/* 10. Safari force-paint — GPU-composite plugin wrappers */
body.theme-cbs .slick-slider,
body.theme-cbs .product-card,
body.theme-cbs .yith-wcwl-add-to-wishlist,
body.theme-cbs .slick-prev,
body.theme-cbs .slick-next,
body.theme-cbs .slick-dots {
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}
body.theme-cbs a,
body.theme-cbs button,
body.theme-cbs .clck-click { -webkit-tap-highlight-color: transparent; }

/* =========================================================
   CBS — Wishlist Badge: Match cart-count design
   Stored in DB (survives deployments)
   ========================================================= */

/* Style the server-rendered span as a badge (initial state) */
a.wish-list > span {
  position: absolute;
  top: -16px;
  right: -6px;
  min-width: 18px;
  width: 18px;
  height: 18px;
  padding: 0 4px;
  background: rgb(31, 146, 191);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 99px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  line-height: 11px;
  pointer-events: none;
  box-sizing: border-box;
}

/* When JS adds .wl-badge class dynamically, style it the same way */
a.wish-list .wl-badge {
  position: absolute;
  top: -16px;
  right: -6px;
  min-width: 18px;
  width: 18px;
  height: 18px;
  padding: 0 4px;
  background: rgb(31, 146, 191);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 99px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  line-height: 11px;
  pointer-events: none;
  box-sizing: border-box;
}

/* Hide the server-rendered plain span if a .wl-badge exists (dynamic state) */
a.wish-list:has(.wl-badge) > span:not(.wl-badge) {
  display: none !important;
}

/* Ensure the wishlist link is positioned relatively */
a.wish-list {
  position: relative !important;
  display: inline-flex !important;
}


/* =================================================================
   CBS — Product Card UI Redesign v2
   All changes are purely visual. Class names & JS hooks untouched.
   ================================================================= */

/* ── 1. CARD SHELL ─────────────────────────────────────────────── */
.woocommerce ul.products li.product,
.woocommerce-page ul.products li.product,
.bestsellers-products-container .product-card {
  background: #1a1a1a !important;
  border: 1.5px solid rgba(255,255,255,0.08) !important;
  border-radius: 16px !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease !important;
  box-shadow: 0 4px 18px rgba(0,0,0,0.4) !important;
  padding-bottom: 0 !important;
}

.woocommerce ul.products li.product:hover,
.woocommerce-page ul.products li.product:hover,
.bestsellers-products-container .product-card:hover {
  border-color: rgba(31,146,191,0.5) !important;
  box-shadow: 0 8px 28px rgba(31,146,191,0.2) !important;
  transform: translateY(-3px) !important;
}

/* ── 2. IMAGE BOX (square, overflow hidden for rotation) ────────── */
.woocommerce ul.products li.product .image-box,
.bestsellers-products-container .product-card .imb-bx {
  position: relative !important;
  width: 100% !important;
  aspect-ratio: 1 / 1 !important;
  overflow: hidden !important;
  background: #111 !important;
  margin: 0 !important;
  flex-shrink: 0 !important;
}

/* Image sits inside the box */
.woocommerce ul.products li.product a img,
.woocommerce ul.products li.product .image-box img,
.bestsellers-products-container .product-card .imb-bx img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
  display: block !important;
  margin: 0 !important;
  padding: 8px !important;
  background: #111 !important;
  transition: transform 0.8s cubic-bezier(0.25,0.46,0.45,0.94) !important;
  transform: rotate(0deg) translateX(0) translateY(0) !important;
}

/* effectOn: rotate image within the clipped box */
.woocommerce ul.products li.product.effectOn a img,
.woocommerce ul.products li.product.effectOn .image-box img {
  transform: rotate(-20deg) translateX(30px) translateY(20px) scale(1.15) !important;
}

/* ── 3. CURSOR/CLICK ICON ──────────────────────────────────────── */
span.clck-click {
  position: absolute !important;
  right: 10px !important;
  top: 10px !important;
  width: 32px !important;
  height: 32px !important;
  background: rgba(31,146,191,0.9) !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 10 !important;
  transition: background 0.2s, transform 0.2s !important;
  transform: scale(1) !important;
  cursor: pointer !important;
}

span.clck-click:hover {
  background: rgb(31,146,191) !important;
  transform: scale(1.15) !important;
}

span.clck-click i[class*="ph-"] {
  font-size: 16px !important;
  color: #fff !important;
  line-height: 1 !important;
  display: flex !important;
}

/* ── 4. SLIDE-IN PILLS ─────────────────────────────────────────── */
.short-description {
  position: absolute !important;
  top: 10px !important;
  left: -220px !important;
  z-index: 9 !important;
  visibility: hidden !important;
  max-width: 260px !important;
  pointer-events: none !important;
  transition: left 0.4s cubic-bezier(0.34,1.2,0.64,1) !important;
}

.effectOn .short-description,
.product-card.effect1.effectOn .short-description {
  left: 8px !important;
  visibility: visible !important;
}

.short-description ul {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 5px !important;
  flex-wrap: nowrap !important;
  justify-content: flex-start !important;
}

.short-description ul li {
  display: inline-block !important;
  background: rgba(5,10,15,0.82) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
  color: #fff !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  padding: 4px 11px !important;
  border-radius: 30px !important;
  border: 1px solid rgba(31,146,191,0.55) !important;
  white-space: normal !important;
  line-height: 1.4 !important;
  letter-spacing: 0.01em !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4) !important;
}

/* ── 5. CARD INFO AREA ─────────────────────────────────────────── */
/* The link block wraps image + title + price */
.woocommerce ul.products li.product a.woocommerce-loop-product__link,
.bestsellers-products-container .product-card .product-info {
  display: block !important;
  flex: 1 !important;
  text-decoration: none !important;
}

/* Title + Wishlist row */
.product-wish {
  display: flex !important;
  align-items: flex-start !important;
  justify-content: space-between !important;
  gap: 8px !important;
  padding: 12px 14px 6px !important;
}

/* Product Title — clamp to 2 lines, consistent height */
.woocommerce ul.products li.product .woocommerce-loop-product__title,
.woocommerce ul.products li.product h2,
.bestsellers-products-container .product-card .product-title {
  font-size: 13.5px !important;
  font-weight: 600 !important;
  line-height: 1.5 !important;
  color: #eee !important;
  padding: 0 !important;
  margin: 0 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  flex: 1 !important;
}

/* Wishlist */
.product-wish .yith-add-to-wishlist-button-block {
  flex-shrink: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  height: auto !important;
}

.product-wish .yith-wcwl-add-to-wishlist-button svg {
  width: 18px !important;
  height: 18px !important;
  color: rgba(255,255,255,0.3) !important;
  transition: color 0.2s, transform 0.2s !important;
}

.product-wish .yith-wcwl-add-to-wishlist-button.yith-wcwl-add-to-wishlist-button--added svg,
.product-wish .yith-wcwl-add-to-wishlist-button:hover svg {
  color: rgb(31,146,191) !important;
  transform: scale(1.2) !important;
}

/* ── 6. PRICE ──────────────────────────────────────────────────── */
.woocommerce ul.products li.product .price,
.bestsellers-products-container .product-card .product-price {
  padding: 0 14px 10px !important;
  margin: 0 !important;
  display: block !important;
}

.woocommerce ul.products li.product .price .woocommerce-Price-amount,
.woocommerce ul.products li.product .price bdi {
  font-size: 17px !important;
  font-weight: 700 !important;
  color: #fff !important;
  letter-spacing: -0.01em !important;
}

.woocommerce ul.products li.product .price .from {
  font-size: 10px !important;
  font-weight: 500 !important;
  color: rgba(255,255,255,0.4) !important;
  text-transform: uppercase !important;
  letter-spacing: 0.07em !important;
  display: block !important;
  margin-bottom: 1px !important;
}

.woocommerce ul.products li.product .price del .woocommerce-Price-amount,
.woocommerce ul.products li.product .price del bdi {
  font-size: 12px !important;
  color: rgba(255,255,255,0.3) !important;
  font-weight: 400 !important;
}

/* ── 7. CTA BUTTON ─────────────────────────────────────────────── */
.woocommerce ul.products li.product a.button,
.woocommerce-page ul.products li.product a.button,
.bestsellers-products-container .product-card .product-actions a {
  display: block !important;
  margin: 0 14px 14px !important;
  padding: 10px 16px !important;
  background: rgb(31,146,191) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 10px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: background 0.2s, box-shadow 0.2s, transform 0.15s !important;
  box-shadow: 0 3px 10px rgba(31,146,191,0.28) !important;
  width: auto !important;
}

.woocommerce ul.products li.product a.button:hover,
.woocommerce-page ul.products li.product a.button:hover,
.bestsellers-products-container .product-card .product-actions a:hover {
  background: #19a2d6 !important;
  box-shadow: 0 5px 16px rgba(31,146,191,0.45) !important;
  transform: translateY(-1px) !important;
}

/* ── 8. MOBILE: 2 columns ──────────────────────────────────────── */
@media (max-width: 599px) {
  /* Force 2-column grid on mobile */
  .woocommerce ul.products,
  .woocommerce-page ul.products {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .woocommerce ul.products li.product,
  .woocommerce-page ul.products li.product {
    width: calc(50% - 4px) !important;
    border-radius: 12px !important;
    float: none !important;
    clear: none !important;
    margin: 0 !important;
  }

  .archive.woocommerce-page ul.products li.product {
    width: calc(50% - 4px) !important;
    float: none !important;
    clear: none !important;
    margin: 0 !important;
  }

  .woocommerce ul.products li.product .woocommerce-loop-product__title,
  .woocommerce ul.products li.product h2 {
    font-size: 11.5px !important;
    line-height: 1.45 !important;
  }

  .woocommerce ul.products li.product .price .woocommerce-Price-amount,
  .woocommerce ul.products li.product .price bdi {
    font-size: 14px !important;
  }

  .product-wish {
    padding: 9px 10px 4px !important;
  }

  .woocommerce ul.products li.product .price {
    padding: 0 10px 8px !important;
  }

  .woocommerce ul.products li.product a.button,
  .woocommerce-page ul.products li.product a.button {
    margin: 0 10px 10px !important;
    padding: 9px 8px !important;
    font-size: 10.5px !important;
    border-radius: 8px !important;
  }

  span.clck-click {
    width: 26px !important;
    height: 26px !important;
    right: 7px !important;
    top: 7px !important;
  }

  span.clck-click i[class*="ph-"] {
    font-size: 13px !important;
  }

  .short-description ul li {
    font-size: 10px !important;
    padding: 3px 8px !important;
  }
}

/* ── 9. Tablet adjustments ──────────────────────────────────────── */
@media (min-width: 600px) and (max-width: 782px) {
  .archive.woocommerce-page ul.products li.product {
    width: calc(50% - 8px) !important;
  }
}

/* ═══════════════════════════════════════════════════════════════
   HOME PAGE CAROUSEL CARDS — match brand/shop page li.product style
   ═══════════════════════════════════════════════════════════════ */

/* Card shell */
body.theme-cbs .product-card {
  border: 1.5px solid rgba(255,255,255,0.08) !important;
  border-radius: 16px !important;
  background: rgb(26,26,26) !important;
  overflow: hidden !important;
  display: -webkit-box !important;
  display: flex !important;
  -webkit-box-orient: vertical !important;
  flex-direction: column !important;
  position: relative !important;
  -webkit-transition: border-color 0.2s ease, -webkit-transform 0.15s ease !important;
  transition: border-color 0.2s ease, transform 0.15s ease !important;
}
body.theme-cbs .product-card:hover {
  border-color: rgba(255,255,255,0.18) !important;
}

/* Product image area fills card top flush */
body.theme-cbs .product-card .product-image {
  border-radius: 0 !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
}
body.theme-cbs .product-card .product-image .imb-bx {
  border-radius: 0 !important;
  overflow: hidden !important;
}
body.theme-cbs .product-card .product-image img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
  border-radius: 0 !important;
}
/* Bestseller cards: contain + dark bg like similar products */
.bestsellers-products-container .product-card .imb-bx img {
  object-fit: contain !important;
  padding: 8px !important;
  background: #111 !important;
}

/* Product info area */
body.theme-cbs .product-card .product-info {
  padding: 12px 14px 6px !important;
  display: -webkit-box !important;
  display: flex !important;
  -webkit-box-orient: vertical !important;
  flex-direction: column !important;
  flex: 1 !important;
  gap: 4px !important;
}

/* Product title */
body.theme-cbs .product-card .product-info .product-title,
body.theme-cbs .product-card .product-info h2,
body.theme-cbs .product-card .product-info .woocommerce-loop-product__title {
  font-size: 13.5px !important;
  font-weight: 600 !important;
  line-height: 1.5 !important;
  color: #eee !important;
  margin: 0 !important;
  padding: 0 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}

/* Price */
body.theme-cbs .product-card .product-info .price,
body.theme-cbs .product-card .product-info .product-price {
  font-size: 13px !important;
  font-weight: 600 !important;
  color: #fff !important;
  margin: 4px 0 0 !important;
}

/* Product actions / button */
body.theme-cbs .product-card .product-actions {
  padding: 10px 14px 14px !important;
}
body.theme-cbs .product-card .product-actions .select-options,
body.theme-cbs .product-card .product-actions a.button {
  display: block !important;
  width: 100% !important;
  text-align: center !important;
  background: rgb(31,146,191) !important;
  color: #fff !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.05em !important;
  text-transform: uppercase !important;
  border-radius: 10px !important;
  padding: 10px 0 !important;
  border: none !important;
  -webkit-transition: background 0.2s ease !important;
  transition: background 0.2s ease !important;
  cursor: pointer !important;
}
body.theme-cbs .product-card .product-actions .select-options:hover,
body.theme-cbs .product-card .product-actions a.button:hover {
  background: rgb(26,122,158) !important;
}

/* ═══════════════════════════════════════════════════════════════
   OUT-OF-STOCK CARDS — active Notify Me + active trigger button
   ═══════════════════════════════════════════════════════════════ */

/* Override the global disabled rule — clck-click and notify-me should stay active */
body.theme-cbs .product-card.outofstock .clck-click,
body.theme-cbs li.product.outofstock .clck-click {
  opacity: 1 !important;
  pointer-events: auto !important;
  cursor: pointer !important;
}
body.theme-cbs .product-card.outofstock .clck-click i,
body.theme-cbs li.product.outofstock .clck-click i {
  opacity: 1 !important;
}

/* Notify Me button — fully styled and active */
body.theme-cbs .product-card.outofstock .notify-me-button,
body.theme-cbs li.product.outofstock .notify-me-button,
body.theme-cbs .product-card.outofstock .button.notify-me-button,
body.theme-cbs li.product.outofstock .button.notify-me-button {
  display: block !important;
  width: 100% !important;
  text-align: center !important;
  background: rgba(255,255,255,0.08) !important;
  color: #fff !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.05em !important;
  text-transform: uppercase !important;
  border-radius: 10px !important;
  padding: 10px 0 !important;
  border: 1.5px solid rgba(255,255,255,0.25) !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  cursor: pointer !important;
  -webkit-transition: background 0.2s ease, border-color 0.2s ease !important;
  transition: background 0.2s ease, border-color 0.2s ease !important;
}
body.theme-cbs .product-card.outofstock .notify-me-button:hover,
body.theme-cbs li.product.outofstock .notify-me-button:hover {
  background: rgba(255,255,255,0.14) !important;
  border-color: rgba(255,255,255,0.45) !important;
}

/* notify-me-wrapper layout */
body.theme-cbs .notify-me-wrapper {
  padding: 10px 14px 14px !important;
}
body.theme-cbs li.product .notify-me-wrapper {
  padding: 10px 0 0 !important;
}






/* ==========================================================================
   PRODUCT PAGE — COMPLETE REDESIGN (Clean slate)
   Inspired by: Gymshark, Myprotein, Amazon — adapted for CBS dark theme
   ========================================================================== */


/* ── 0. RESET CONFLICTS ──────────────────────────────────────────────────── */
body.single-product .woocommerce-product-gallery,
body.single-product .summary.entry-summary {
  width: auto !important;
  float: none !important;
}



/* ── 2. GALLERY (CARD) ──────────────────────────────────────────────────── */

/* ─── Outer gallery/card container ─── */
/* On desktop: card with rounded corners, gap from header, horizontal margin */
body.single-product .woocommerce-product-gallery {
  background: #0e0e0e !important;
  border-radius: 18px !important;
  overflow: visible !important;
  border: 1px solid rgba(255,255,255,0.09) !important;
  margin: 14px 0 24px !important;
  box-shadow: 0 4px 24px rgba(0,0,0,0.45) !important;
}

/* Main image slider */
body.single-product .woocommerce-product-gallery__wrapper.product-images-slider {
  background: #0e0e0e !important;
  border-radius: 0 !important;
  padding-bottom: 0 !important;
  min-height: 0 !important;
}

body.single-product .woocommerce-product-gallery__image img {
  width: 100% !important;
  display: block !important;
  object-fit: contain !important;
  background: #0e0e0e !important;
}

/* ─── Thumbnail strip ─── */
body.single-product .thumb-gallery-slider {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  width: 100% !important;
  gap: 8px !important;
  padding: 10px 14px !important;
  background: #111 !important;
  border-top: 1px solid rgba(255,255,255,0.07) !important;
  overflow-x: auto !important;
  scrollbar-width: none !important;
  box-sizing: border-box !important;
}
body.single-product .thumb-gallery-slider::-webkit-scrollbar { display: none !important; }

/* Individual thumbnail */
body.single-product .thumb-gallery-slider .product-second-image {
  width: 60px !important;
  height: 60px !important;
  flex-shrink: 0 !important;
  overflow: hidden !important;
  border-radius: 8px !important;
  border: 2px solid transparent !important;
  display: block !important;
  cursor: pointer !important;
  opacity: 0.5 !important;
  transition: opacity 0.2s, border-color 0.2s !important;
  box-sizing: border-box !important;
}
body.single-product .thumb-gallery-slider .product-second-image.active {
  border-color: rgb(57,137,178) !important;
  opacity: 1 !important;
}
body.single-product .thumb-gallery-slider .product-second-image:hover {
  opacity: 0.85 !important;
}
body.single-product .thumb-gallery-slider .product-second-image a {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  pointer-events: none !important;
}
body.single-product .thumb-gallery-slider .product-second-image img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

/* ─── Summary (inside gallery card) ─── */
body.single-product .summary.entry-summary {
  position: relative !important;
  background: #111 !important;
  padding: 16px 16px 20px !important;
  border-top: 1px solid rgba(255,255,255,0.07) !important;
  margin-top: 0 !important;
}

/* ── 3. PRODUCT SUMMARY / TITLE / PRICE ─────────────────────────────────── */

/* Wishlist — floated to top-right, aligned with title text baseline */
body.single-product .summary .custom-wishlist {
  position: absolute !important;
  top: 10px !important;
  right: 16px !important;
  margin: 0 !important;
  display: flex !important;
  align-items: center !important;
  height: 32px !important;
}

/* Title: make room for wishlist button on the right */
body.single-product .summary .product_title.entry-title {
  font-size: 17px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  color: #fff !important;
  margin: 0 0 6px !important;
  letter-spacing: -0.01em !important;
  text-transform: none !important;
  padding-right: 48px !important;
  display: block !important;
}

/* Price */
body.single-product .summary .price {
  font-size: 22px !important;
  font-weight: 700 !important;
  color: #fff !important;
  letter-spacing: -0.02em !important;
  margin: 0 0 12px !important;
  display: block !important;
  line-height: 1 !important;
}
body.single-product .summary .price del {
  opacity: 0.35 !important;
  font-size: 0.65em !important;
  font-weight: 400 !important;
}
body.single-product .summary .price ins {
  text-decoration: none !important;
}

/* ── 4. WISHLIST HEART BUTTON ────────────────────────────────────────────── */
body.single-product .summary > .yith-add-to-wishlist-button-block {
  display: none !important;
}
body.single-product .custom-wishlist {
  display: inline-flex !important;
  align-items: center !important;
  flex-shrink: 0 !important;
  margin: 0 !important;
  float: none !important;
  height: auto !important;
  line-height: 1 !important;
  padding: 0 !important;
}
body.single-product .custom-wishlist .yith-add-to-wishlist-button-block {
  margin: 0 !important;
}
body.single-product .yith-wcwl-add-to-wishlist-button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 50% !important;
  background: rgba(57,137,178,0.12) !important;
  border: 1.5px solid rgba(57,137,178,0.35) !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  color: rgb(57,137,178) !important;
  text-decoration: none !important;
  padding: 0 !important;
  flex-shrink: 0 !important;
}
body.single-product .yith-wcwl-add-to-wishlist-button:hover {
  background: rgba(57,137,178,0.22) !important;
  border-color: rgb(57,137,178) !important;
}
body.single-product .yith-wcwl-add-to-wishlist-button__label {
  display: none !important;
}
body.single-product .yith-wcwl-icon.yith-wcwl-icon-svg {
  width: 15px !important;
  height: 15px !important;
  display: block !important;
  flex-shrink: 0 !important;
  stroke: currentColor !important;
  fill: none !important;
}
body.single-product .yith-wcwl-add-to-wishlist-button--added .yith-wcwl-icon-svg {
  fill: currentColor !important;
}

/* ── 5. FEATURE PILLS ────────────────────────────────────────────────────── */
body.single-product .woocommerce-product-details__short-description {
  margin: 0 0 14px !important;
}
body.single-product .woocommerce-product-details__short-description ul {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 6px !important;
  margin: 0 !important;
  padding: 0 !important;
  list-style: none !important;
}
body.single-product .woocommerce-product-details__short-description ul li {
  display: inline-flex !important;
  align-items: center !important;
  padding: 5px 11px !important;
  border: 1px solid rgba(57,137,178,0.3) !important;
  border-radius: 20px !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  color: rgba(255,255,255,0.75) !important;
  background: rgba(57,137,178,0.07) !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  line-height: 1 !important;
  white-space: nowrap !important;
}

/* ── 6. VARIATION SELECTOR (FLAVOUR) ────────────────────────────────────── */
body.single-product .variations_form .variations {
  margin: 0 0 6px !important;
}
body.single-product .variations_form .variations th.label {
  padding: 0 0 8px !important;
  text-align: left !important;
  vertical-align: middle !important;
  width: auto !important;
}
body.single-product .variations_form .variations th.label label {
  font-size: 10px !important;
  font-weight: 600 !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  color: rgba(255,255,255,0.4) !important;
  display: block !important;
}
body.single-product .variations_form .variations td.value {
  padding: 0 0 4px !important;
  vertical-align: middle !important;
}
body.single-product .variations_form .variations .variation-radios {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 7px !important;
}
body.single-product .variation-radio {
  position: absolute !important;
  opacity: 0 !important;
  pointer-events: none !important;
  width: 0 !important;
  height: 0 !important;
  overflow: hidden !important;
}
body.single-product .variation-radio + label {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0 !important;
  flex-grow: 0 !important;
  white-space: nowrap !important;
  padding: 6px 14px !important;
  border: 1.5px solid rgba(255,255,255,0.12) !important;
  border-radius: 8px !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  color: rgba(255,255,255,0.6) !important;
  background: rgba(255,255,255,0.04) !important;
  cursor: pointer !important;
  transition: all 0.18s ease !important;
  line-height: 1.2 !important;
  text-align: center !important;
  width: auto !important;
}
body.single-product .variation-radio + label:hover {
  border-color: rgba(57,137,178,0.5) !important;
  color: rgba(255,255,255,0.9) !important;
  background: rgba(57,137,178,0.08) !important;
}
body.single-product .variation-radio:checked + label {
  border-color: rgb(57,137,178) !important;
  color: #fff !important;
  background: rgba(57,137,178,0.15) !important;
}

/* ── 7. QUANTITY + CTA BUTTONS ──────────────────────────────────────────── */
/* Button box container */
body.single-product .woo-button-box {
  display: flex !important;
  align-items: stretch !important;
  gap: 8px !important;
  width: 100% !important;
  margin-top: 4px !important;
}
/* Quantity stepper - targets actual HTML structure */
/* The .quantity div contains: label, input.qty, .quantity-wrapper{minus btn, plus btn} */
/* Make the whole thing a flex row: [minus] [input number] [plus] */
body.single-product .woocommerce-variation-add-to-cart .quantity {
  display: flex !important;
  align-items: center !important;
  gap: 0 !important;
  margin: 0 0 10px !important;
  border: 1.5px solid rgba(255,255,255,0.12) !important;
  border-radius: 10px !important;
  overflow: hidden !important;
  background: rgba(255,255,255,0.04) !important;
  width: fit-content !important;
  height: 44px !important;
}
/* Hide screen-reader label */
body.single-product .woocommerce-variation-add-to-cart .quantity label {
  display: none !important;
}
/* The qty number input - shows between buttons */
body.single-product .woocommerce-variation-add-to-cart .input-text.qty {
  order: 2 !important;
  flex: 0 0 auto !important;
  width: 40px !important;
  height: 40px !important;
  text-align: center !important;
  background: transparent !important;
  border: none !important;
  color: #fff !important;
  font-size: 14px !important;
  font-weight: 600 !important;
  padding: 0 !important;
  margin: 0 !important;
  -moz-appearance: textfield !important;
  display: block !important;
}
body.single-product .woocommerce-variation-add-to-cart .input-text.qty::-webkit-outer-spin-button,
body.single-product .woocommerce-variation-add-to-cart .input-text.qty::-webkit-inner-spin-button {
  -webkit-appearance: none !important;
  margin: 0 !important;
}
/* quantity-wrapper contains minus and plus buttons */
body.single-product .woocommerce-variation-add-to-cart .quantity .quantity-wrapper {
  order: 1 !important;
  display: contents !important;
}
body.single-product .woocommerce-variation-add-to-cart .quantity .qty-btn.minus {
  order: 1 !important;
}
body.single-product .woocommerce-variation-add-to-cart .quantity .qty-btn.plus {
  order: 3 !important;
}
body.single-product .woocommerce-variation-add-to-cart .quantity .qty-btn {
  background: transparent !important;
  border: none !important;
  color: rgba(255,255,255,0.6) !important;
  font-size: 18px !important;
  font-weight: 400 !important;
  cursor: pointer !important;
  padding: 0 14px !important;
  height: 44px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: color 0.15s !important;
  line-height: 1 !important;
  flex: 0 0 auto !important;
}
body.single-product .woocommerce-variation-add-to-cart .quantity .qty-btn:hover {
  color: #fff !important;
}

/* CTA Buttons */
body.single-product .single_buy_now_button,
body.single-product .buy-now-btn {
  flex: 1 1 0% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 44px !important;
  border-radius: 10px !important;
  background: rgb(57,137,178) !important;
  color: #000 !important;
  font-size: 13px !important;
  font-weight: 700 !important;
  letter-spacing: 0.04em !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
  border: none !important;
  cursor: pointer !important;
  transition: all 0.18s ease !important;
  white-space: nowrap !important;
}
body.single-product .single_buy_now_button:hover,
body.single-product .buy-now-btn:hover {
  background: rgb(70,155,200) !important;
  color: #000 !important;
}
body.single-product .single_add_to_cart_button.button {
  flex: 1 1 0% !important;
  height: 44px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 10px !important;
  background: transparent !important;
  border: 1.5px solid rgba(57,137,178,0.5) !important;
  color: rgb(57,137,178) !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  transition: all 0.18s ease !important;
  white-space: nowrap !important;
}
body.single-product .single_add_to_cart_button.button:hover {
  background: rgba(57,137,178,0.12) !important;
  border-color: rgb(57,137,178) !important;
  color: #fff !important;
}


/* ── 8. RESPONSIVE (MOBILE ≤ 991px) ─────────────────────────────────────── */
@media (max-width: 991px) {
  body.single-product .product.type-product {
    display: block !important;
    padding: 0 !important;
  }

  /* Card: keep rounded corners on mobile, add top margin and side padding */
  body.single-product .woocommerce-product-gallery {
    border-radius: 16px !important;
    border: 1px solid rgba(255,255,255,0.09) !important;
    margin: 12px 0 20px !important;
    background: #0e0e0e !important;
    overflow: hidden !important;
  }

  body.single-product .woocommerce-product-gallery__image img {
    max-height: 260px !important;
    object-fit: contain !important;
  }

  body.single-product .thumb-gallery-slider {
    padding: 8px 12px !important;
    gap: 6px !important;
  }
  body.single-product .thumb-gallery-slider .product-second-image {
    width: 52px !important;
    height: 52px !important;
  }

  body.single-product .summary.entry-summary {
    padding: 14px 16px 18px !important;
    margin-top: 0 !important;
  }

  body.single-product .summary .custom-wishlist {
    top: 8px !important;
    right: 16px !important;
  }

  body.single-product .summary .product_title.entry-title {
    font-size: 16px !important;
    padding-right: 44px !important;
  }

  body.single-product .summary .price {
    font-size: 20px !important;
    margin-bottom: 10px !important;
  }

  body.single-product .woocommerce-product-details__short-description {
    margin-bottom: 10px !important;
  }

  body.single-product .variations_form .variations {
    margin-bottom: 10px !important;
  }

  body.single-product .variation-radio + label {
    padding: 5px 12px !important;
    font-size: 11px !important;
    border-radius: 7px !important;
  }

  body.single-product .woo-button-box {
    gap: 7px !important;
  }

  body.single-product .qty-box button,
  body.single-product .qty-box [data-type="minus"],
  body.single-product .qty-box [data-type="plus"] {
    height: 42px !important;
    padding: 0 10px !important;
    font-size: 15px !important;
  }

  body.single-product .single_buy_now_button,
  body.single-product .buy-now-btn,
  body.single-product .single_add_to_cart_button.button {
    height: 42px !important;
    font-size: 12px !important;
    border-radius: 9px !important;
    letter-spacing: 0.05em !important;
    white-space: nowrap !important;
  }

  body.single-product .product-detail-main {
    margin-top: 24px !important;
    padding-bottom: 24px !important;
  }

  body.single-product .product-detail-content-box {
    padding: 0 14px !important;
  }

  body.single-product .for-mb .nav.nav-tabs li a {
    padding: 11px 16px !important;
    font-size: 10px !important;
  }

  body.single-product section.related.products {
    margin-top: 24px !important;
    padding: 24px 14px 0 !important;
  }
}


/* ── DESKTOP LAYOUT (992px+) ─────────────────────────────────────────────── */
@media (min-width: 992px) {
  /* Outer product container: block, centered */
  body.single-product .product.type-product {
    display: block !important;
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 32px 32px 0 !important;
  }

  /* Gallery wrapper becomes the 2-column grid:
     left col = images, right col = summary */
  body.single-product .woocommerce-product-gallery {
    display: grid !important;
    grid-template-columns: 52% 1fr !important;
    grid-template-rows: auto auto 1fr !important;
    column-gap: 48px !important;
    align-items: start !important;
    overflow: visible !important;
    border-radius: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 14px 0 24px !important;
  }

  /* Image slider: column 1, rows 1-2 */
  body.single-product .woocommerce-product-gallery__wrapper.product-images-slider {
    grid-column: 1 !important;
    grid-row: 1 !important;
    background: #0e0e0e !important;
    border-radius: 18px 18px 0 0 !important;
    border: 1px solid rgba(255,255,255,0.09) !important;
    border-bottom: none !important;
    position: sticky !important;
    top: 80px !important;
  }

  /* Thumbnail strip: column 1, row 2 */
  body.single-product .thumb-gallery-slider {
    grid-column: 1 !important;
    grid-row: 2 !important;
    background: #111 !important;
    border-radius: 0 0 18px 18px !important;
    border: 1px solid rgba(255,255,255,0.09) !important;
    border-top: none !important;
  }

  /* Custom lightbox: spans both columns */
  body.single-product .custom-lightbox {
    grid-column: 1 / -1 !important;
    grid-row: 99 !important;
  }

  /* Summary: column 2, row 1-2 */
  body.single-product .summary.entry-summary {
    grid-column: 2 !important;
    grid-row: 1 / span 2 !important;
    background: transparent !important;
    border-top: none !important;
    padding: 0 !important;
    position: sticky !important;
    top: 80px !important;
    align-self: start !important;
  }

  /* Tabs and related: span full width, outside the 2-col grid */
  body.single-product .woocommerce-tabs.wc-tabs-wrapper,
  body.single-product .product-detail-main,
  body.single-product section.related.products {
    grid-column: 1 / -1 !important;
    float: none !important;
    clear: both !important;
    width: 100% !important;
  }
}


/* ── QUANTITY AREA FIXES ──────────────────────────────────────────────────── */
/* Screen reader label hide (belt and suspenders) */
body.single-product .woocommerce-variation-add-to-cart label.screen-reader-text {
  display: none !important;
}


/* ── PRODUCT RATING — COMPACT BADGE ─────────────────────────────────────── */
/* Layout: [★] [4.5] [·] [10 reviews] in a pill
   JS (cbs_thumb_gallery_swap_script) sets data-score on badge element after load */

body.single-product .woocommerce-product-rating {
  display: inline-flex !important;
  align-items: center !important;
  gap: 0 !important;
  background: rgba(255,255,255,0.05) !important;
  border: 1px solid rgba(255,255,255,0.09) !important;
  border-radius: 20px !important;
  padding: 4px 10px 4px 8px !important;
  margin: 0 0 10px !important;
  line-height: 1 !important;
  cursor: pointer !important;
  text-decoration: none !important;
  flex-wrap: nowrap !important;
}

/* ★ star — flex order 1 */
body.single-product .woocommerce-product-rating::before {
  content: "\2605" !important;
  color: #FFB800 !important;
  font-size: 11px !important;
  line-height: 1 !important;
  margin-right: 5px !important;
  flex-shrink: 0 !important;
  order: 1 !important;
}

/* 4.5 score — flex order 2, via ::after on badge using attr(data-score) */
body.single-product .woocommerce-product-rating[data-score]::after {
  content: attr(data-score) !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  color: rgba(255,255,255,0.8) !important;
  line-height: 1 !important;
  order: 2 !important;
  flex-shrink: 0 !important;
}

/* Hide the WooCommerce CSS star rating widget */
body.single-product .woocommerce-product-rating .star-rating {
  display: none !important;
}

/* Review link — flex order 3 */
body.single-product .woocommerce-review-link {
  order: 3 !important;
  display: inline-flex !important;
  align-items: center !important;
  font-size: 0 !important;
  text-decoration: none !important;
  line-height: 1 !important;
}

/* · dot before the count */
body.single-product .woocommerce-review-link .count::before {
  content: "\00B7" !important;
  font-size: 11px !important;
  color: rgba(255,255,255,0.25) !important;
  font-weight: 400 !important;
  margin: 0 4px !important;
  display: inline !important;
}

/* 10 */
body.single-product .woocommerce-review-link .count {
  display: inline !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  color: rgba(255,255,255,0.45) !important;
  letter-spacing: 0.01em !important;
}

/* " reviews" suffix */
body.single-product .woocommerce-review-link .count::after {
  content: " reviews" !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  color: rgba(255,255,255,0.45) !important;
}

/* Hover */
body.single-product .woocommerce-review-link:hover .count,
body.single-product .woocommerce-review-link:hover .count::before,
body.single-product .woocommerce-review-link:hover .count::after {
  color: rgba(255,255,255,0.75) !important;
}
body.single-product .woocommerce-review-link:hover::before {
  color: rgba(255,255,255,0.95) !important;
}


/* ============================================================
   PRODUCT DETAIL TABS — CARD REDESIGN v2
   ============================================================ */

/* ── Card wrapper ──────────────────────────────────────────── */
.product-detail-main {
  padding: 0 15px !important;
}

.product-detail-content-box {
  background: #141414 !important;
  border: 1px solid rgba(255,255,255,0.08) !important;
  border-radius: 16px !important;
  overflow: hidden !important;
  margin-bottom: 20px !important;
}

/* ── Tab navigation ────────────────────────────────────────── */
.product-detail-content-box .for-mb {
  border-bottom: 1px solid rgba(255,255,255,0.08) !important;
  padding: 0 !important;
}

.product-detail-content-box ul.nav.nav-tabs {
  display: flex !important;
  flex-direction: row !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  list-style: none !important;
  width: 100% !important;
}

.product-detail-content-box ul.nav.nav-tabs li {
  flex: 1 !important;
  display: flex !important;
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.product-detail-content-box ul.nav.nav-tabs li a {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  padding: 18px 12px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
  text-align: center !important;
  color: rgba(255,255,255,0.35) !important;
  text-decoration: none !important;
  border: none !important;
  border-bottom: 2px solid transparent !important;
  background: transparent !important;
  transition: color 0.2s, border-color 0.2s !important;
  position: relative !important;
}

/* Kill the pseudo-element pipe */
.product-detail-content-box ul.nav.nav-tabs li a::before,
.product-detail-content-box ul.nav.nav-tabs li a::after {
  display: none !important;
  content: none !important;
}

.product-detail-content-box ul.nav.nav-tabs li a:hover {
  color: rgba(255,255,255,0.65) !important;
}

.product-detail-content-box ul.nav.nav-tabs li a.active,
.product-detail-content-box ul.nav.nav-tabs li a.active.show {
  color: #fff !important;
  border-bottom-color: rgb(57,137,178) !important;
}

/* ── Tab content area ──────────────────────────────────────── */
.product-detail-content-box .tab-content {
  padding: 24px 22px !important;
  background: transparent !important;
}

.product-detail-content-box .tab-pane p,
.product-detail-content-box .tab-pane li {
  font-size: 13px !important;
  line-height: 1.8 !important;
  color: rgba(255,255,255,0.68) !important;
  margin-bottom: 6px !important;
}

/* ============================================================
   REVIEWS — PREMIUM REDESIGN v5
   ============================================================ */

/* ── Hide plugin chrome ──────────────────────────────────────── */
.woocommerce-Reviews-title { display: none !important; }

/* ── Write Review — small quiet link top-right ───────────────── */
.write-review {
  display: flex !important;
  justify-content: flex-end !important;
  margin-bottom: 22px !important;
  padding-bottom: 18px !important;
  border-bottom: 1px solid rgba(255,255,255,0.07) !important;
}
.write-review span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 5px !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  letter-spacing: 0.13em !important;
  text-transform: uppercase !important;
  color: rgba(255,255,255,0.35) !important;
  cursor: pointer !important;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  transition: color 0.2s !important;
}
.write-review span:hover { color: rgb(57,137,178) !important; }
.write-review span svg { width: 12px !important; height: 12px !important; opacity: 0.5 !important; }
.write-review span:hover svg { opacity: 1 !important; }
.write-review span svg path { stroke: currentColor !important; }

/* ── Summary section ─────────────────────────────────────────── */
/* Override plugin's white background with high specificity */
#reviews .cr-summaryBox-wrap,
.woocommerce #reviews .cr-summaryBox-wrap {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 24px !important;
  margin-bottom: 24px !important;
  padding: 0 0 20px 0 !important;
  border-bottom: 1px solid rgba(255,255,255,0.07) !important;
  background: none !important;
  background-color: transparent !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}

.cr-overall-rating-wrap {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 12px !important;
  flex-shrink: 0 !important;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  border-radius: 0 !important;
}

.cr-average-rating {
  font-size: 48px !important;
  font-weight: 800 !important;
  color: #fff !important;
  line-height: 1 !important;
  letter-spacing: -0.04em !important;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  width: auto !important;
  height: auto !important;
}

.cr-average-rating-stars {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
}

/* Preserve plugin SVG star system — position:relative is critical */
.cr-average-rating-stars .crstar-rating-svg {
  display: inline-block !important;
  position: relative !important;
}
.cr-average-rating-stars .cr-rating-icon-base .cr-rating-icon-bg {
  stroke: rgba(255,255,255,0.15) !important;
  fill: none !important;
}
.cr-average-rating-stars .cr-rating-icon-frnt .cr-rating-icon {
  fill: rgb(255,188,0) !important;
}

.cr-total-rating-count,
.cr-based-on {
  font-size: 10px !important;
  color: rgba(255,255,255,0.3) !important;
  letter-spacing: 0.03em !important;
  margin: 0 !important;
  background: none !important;
  border: none !important;
  padding: 0 !important;
}

/* ── Histogram ───────────────────────────────────────────────── */
.ivole-summaryBox {
  flex: 1 !important;
  background: none !important;
  padding: 0 !important;
  border: none !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}
.cr-histogramTable {
  width: 100% !important;
  border-collapse: collapse !important;
  background: none !important;
}
.ivole-histogramRow {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  margin-bottom: 4px !important;
  background: none !important;
  font-size: 10px !important;
}
.ivole-histogramRow td {
  padding: 2px 0 !important;
  border: none !important;
  background: none !important;
  font-size: 10px !important;
  line-height: 1.2 !important;
}
.ivole-histogramCell1 {
  width: 36px !important;
  flex-shrink: 0 !important;
  font-size: 9px !important;
  color: rgba(255,255,255,0.3) !important;
  letter-spacing: 0.03em !important;
}
.ivole-histogramCell1 span {
  font-size: 9px !important;
  color: rgba(255,255,255,0.3) !important;
  letter-spacing: 0.03em !important;
}
.ivole-histogramCell2 { flex: 1 !important; }
.ivole-meter {
  width: 100% !important;
  height: 3px !important;
  background: rgba(255,255,255,0.08) !important;
  border-radius: 2px !important;
  overflow: hidden !important;
}
.ivole-meter-bar {
  height: 3px !important;
  background: rgb(57,137,178) !important;
  border-radius: 2px !important;
  font-size: 0 !important;
  color: transparent !important;
}
.ivole-histogramCell3 {
  width: 28px !important;
  flex-shrink: 0 !important;
  text-align: right !important;
  font-size: 9px !important;
  color: rgba(255,255,255,0.25) !important;
}
.ivole-histogramCell3 span {
  font-size: 9px !important;
  color: rgba(255,255,255,0.25) !important;
}

/* ── Review list: subtle dividers only ────────────────────────── */
.commentlist {
  list-style: none !important;
  padding: 0 !important;
  margin: 0 !important;
}
.commentlist li.comment {
  background: none !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 22px 0 !important;
  margin: 0 !important;
  border-bottom: 1px solid rgba(255,255,255,0.06) !important;
  box-shadow: none !important;
}
.commentlist li.comment:last-child { border-bottom: none !important; }

/* comment_container: needs position:relative because avatar is absolute */
.comment_container {
  position: relative !important;
  min-height: 44px !important;
  background: none !important;
}

/* Avatar: absolutely positioned (plugin forces it, we work with it) */
#reviews .comment_container img.avatar,
.comment_container img.avatar {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 38px !important;
  height: 38px !important;
  border-radius: 50% !important;
  opacity: 0.45 !important;
  filter: grayscale(50%) !important;
  object-fit: cover !important;
}

/* comment-text: left-margin to clear the 38px avatar */
/* Must beat: .woocommerce #reviews #comments ol.commentlist li .comment-text { margin-left:50px } */
.woocommerce #reviews #comments ol.commentlist li .comment-text,
.comment-text {
  margin-left: 52px !important;
  background: none !important;
  padding: 0 !important;
  border: none !important;
  box-shadow: none !important;
}

/* Force gold color on star-rating — beats .tab-pane p/li rgba rule */
.product-detail-content-box .tab-pane .comment-text .star-rating,
.woocommerce #reviews .commentlist li.review .comment-text .star-rating {
  color: rgb(255,188,0) !important;
}

/* Stars — above meta, left-aligned, overrides WC float:right */
.woocommerce #reviews .commentlist li.review .comment-text .star-rating,
#reviews .commentlist li.review .comment-text .star-rating,
.comment-text .star-rating {
  float: none !important;
  display: block !important;
  font-family: WooCommerce !important;
  font-size: 12px !important;
  height: 1em !important;
  line-height: 1 !important;
  overflow: hidden !important;
  position: relative !important;
  width: 5.4em !important;
  margin-bottom: 7px !important;
}
.woocommerce #reviews .commentlist li.review .comment-text .star-rating::before,
#reviews .commentlist li.review .comment-text .star-rating::before,
.comment-text .star-rating::before {
  content: "sssss" !important;
  color: rgba(255,255,255,0.15) !important;
  float: left !important;
  top: 0 !important;
  left: 0 !important;
  position: absolute !important;
  font-family: WooCommerce !important;
}
.woocommerce #reviews .commentlist li.review .comment-text .star-rating span,
#reviews .commentlist li.review .comment-text .star-rating span,
.comment-text .star-rating span {
  overflow: hidden !important;
  float: left !important;
  top: 0 !important;
  left: 0 !important;
  position: absolute !important;
  padding-top: 1.5em !important;
  display: block !important;
}
.woocommerce #reviews .commentlist li.review .comment-text .star-rating span::before,
#reviews .commentlist li.review .comment-text .star-rating span::before,
.comment-text .star-rating span::before {
  content: "SSSSS" !important;
  top: 0 !important;
  position: absolute !important;
  left: 0 !important;
  color: rgb(255,188,0) !important;
  font-family: WooCommerce !important;
}

/* Meta: author — date */
.comment-text .meta {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 5px !important;
  flex-wrap: wrap !important;
  margin: 0 0 7px !important;
  background: none !important;
  padding: 0 !important;
  border: none !important;
  font-size: 12px !important;
}
.woocommerce-review__author {
  font-size: 12px !important;
  font-weight: 600 !important;
  color: rgba(255,255,255,0.8) !important;
  background: none !important;
}
.woocommerce-review__verified { color: rgba(255,255,255,0.3) !important; font-size: 10px !important; }
.woocommerce-review__dash { color: rgba(255,255,255,0.2) !important; }
.woocommerce-review__published-date {
  font-size: 10px !important;
  color: rgba(255,255,255,0.28) !important;
  background: none !important;
  border: none !important;
  padding: 0 !important;
}

/* Review title */
.cr-comment-head-text {
  font-size: 13px !important;
  font-weight: 700 !important;
  color: rgba(255,255,255,0.82) !important;
  margin-bottom: 5px !important;
  letter-spacing: 0.01em !important;
  background: none !important;
}

/* Review body */
.description {
  font-size: 13px !important;
  line-height: 1.65 !important;
  color: rgba(255,255,255,0.45) !important;
  margin: 0 !important;
  padding: 0 !important;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}
.description p {
  margin: 0 0 4px !important;
  color: rgba(255,255,255,0.45) !important;
}

/* Verified / country badge */
.ivole-verified-badge {
  display: inline-flex !important;
  align-items: center !important;
  gap: 4px !important;
  margin-top: 8px !important;
  background: none !important;
}
.ivole-review-country-text,
.ivole-verified-badge span {
  font-size: 9px !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  color: rgba(57,137,178,0.7) !important;
}
.ivole-review-country-icon { width: 12px !important; height: 12px !important; }

/* ── Store manager reply ──────────────────────────────────────── */
.commentlist ul.children {
  list-style: none !important;
  padding: 0 !important;
  margin: 14px 0 0 52px !important;
}
.commentlist ul.children li {
  background: none !important;
  border: none !important;
  padding: 0 !important;
  box-shadow: none !important;
}
.commentlist ul.children .comment_container {
  position: relative !important;
  min-height: 32px !important;
}
.commentlist ul.children .comment_container img.avatar {
  width: 26px !important;
  height: 26px !important;
  opacity: 0.35 !important;
}
.commentlist ul.children .comment-text {
  margin-left: 36px !important;
  padding-left: 12px !important;
  border-left: 1px solid rgba(57,137,178,0.25) !important;
  border-bottom: none !important;
}
.commentlist ul.children .woocommerce-review__author {
  font-size: 11px !important;
  color: rgba(255,255,255,0.45) !important;
}
.commentlist ul.children .woocommerce-review__published-date { font-size: 9px !important; }
.commentlist ul.children .description,
.commentlist ul.children .description p {
  font-size: 12px !important;
  color: rgba(255,255,255,0.38) !important;
  margin-top: 4px !important;
}

/* ── Review form ──────────────────────────────────────────────── */
.cr-single-product-review {
  margin-top: 24px !important;
  padding-top: 20px !important;
  border-top: 1px solid rgba(255,255,255,0.07) !important;
}
#review_form_wrapper, #review_form { background: none !important; }
#review_form .comment-reply-title {
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  color: rgba(255,255,255,0.45) !important;
  margin-bottom: 16px !important;
}
#review_form label {
  font-size: 10px !important;
  color: rgba(255,255,255,0.35) !important;
  text-transform: uppercase !important;
  letter-spacing: 0.07em !important;
  display: block !important;
  margin-bottom: 5px !important;
}
#review_form input[type="text"],
#review_form input[type="email"],
#review_form textarea {
  background: rgba(255,255,255,0.04) !important;
  border: 1px solid rgba(255,255,255,0.09) !important;
  border-radius: 6px !important;
  color: rgba(255,255,255,0.75) !important;
  font-size: 12px !important;
  padding: 9px 12px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
#review_form input:focus,
#review_form textarea:focus {
  outline: none !important;
  border-color: rgba(57,137,178,0.4) !important;
}
#review_form .form-submit input[type="submit"] {
  background: transparent !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
  color: rgba(255,255,255,0.5) !important;
  border-radius: 6px !important;
  padding: 9px 22px !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  transition: all 0.2s !important;
}
#review_form .form-submit input[type="submit"]:hover {
  border-color: rgb(57,137,178) !important;
  color: rgb(57,137,178) !important;
}

/* ── No reviews ───────────────────────────────────────────────── */
.woocommerce-noreviews {
  font-size: 12px !important;
  color: rgba(255,255,255,0.28) !important;
  padding: 20px 0 !important;
  text-align: center !important;
  letter-spacing: 0.04em !important;
}

		</style>
