  <!-- ===== MOBILE search scrim (dims the page behind the top search overlay) ===== -->
  <button class="cbs-nav__msearch-scrim" type="button" data-cbs-msearch-close aria-label="Close search" tabindex="-1"></button>

</header>

<script>
var cbsHomeShopUrl = "https://crossbordersupps.com/shop/";
var cbsHomeUrl = "https://crossbordersupps.com/";
function cbsSearchUrl(q){ return cbsHomeUrl + "?s=" + encodeURIComponent(q) + "&post_type=product"; }

(function(){
  var nav = document.querySelector('[data-cbs-nav]');
  if (!nav) return;
  var body = document.body;
  var shopSheet   = document.getElementById('cbs-nav-shop-sheet');
  var searchSheet = document.getElementById('cbs-nav-search-sheet');
  var mobile      = document.getElementById('cbs-nav-mobile-drawer');
  var searchInput = nav.querySelector('[data-cbs-search-input]');
  var searchPanel = nav.querySelector('[data-cbs-search-panel]');
  var searchPill  = nav.querySelector('[data-cbs-search-pill]');

  var cbsLastY = window.scrollY, cbsHideAfter = 80, cbsStopTimer = null, cbsDownAccum = 0, CBS_HIDE_DISTANCE = 150;
  function onScroll(){
    var y = window.scrollY, dy = y - cbsLastY;
    cbsLastY = y;
    nav.classList.toggle('is-scrolled', y > 8);
    if (y <= cbsHideAfter) { cbsDownAccum = 0; nav.classList.remove('is-hidden'); }
    else if (dy > 0) {
      /* only hide once a real downward gesture has covered enough distance (ignore tiny/low-intensity scrolls) */
      cbsDownAccum += dy;
      if (cbsDownAccum > CBS_HIDE_DISTANCE && !nav.classList.contains('is-shop') && !nav.classList.contains('is-searching') && !nav.classList.contains('is-mobile-open')) { nav.classList.add('is-hidden'); }
    } else if (dy < 0) { cbsDownAccum = 0; nav.classList.remove('is-hidden'); }
    /* when scrolling stops, reset the gesture and bring the nav back */
    if (cbsStopTimer) clearTimeout(cbsStopTimer);
    cbsStopTimer = setTimeout(function(){ nav.classList.remove('is-hidden'); cbsDownAccum = 0; }, 200);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setExpanded(sel, val){ document.querySelectorAll(sel).forEach(function(b){ b.setAttribute('aria-expanded', val ? 'true' : 'false'); }); }
  function closeAll(except){
    var isShop = except === 'shop', isSearch = except === 'search', isMobile = except === 'mobile';
    nav.classList.toggle('is-shop', isShop);
    nav.classList.toggle('is-searching', isSearch);
    nav.classList.toggle('is-mobile-open', isMobile);
    setExpanded('[data-cbs-shop-trigger]', isShop);
    setExpanded('[data-cbs-mobile-trigger]', isMobile);
    setExpanded('[data-cbs-search-toggle]', isSearch);
    if (shopSheet)   shopSheet.setAttribute('aria-hidden', isShop ? 'false' : 'true');
    if (searchSheet) searchSheet.setAttribute('aria-hidden', isSearch ? 'false' : 'true');
    if (mobile)      mobile.setAttribute('aria-hidden', isMobile ? 'false' : 'true');
    var lockForSearch = isSearch && window.matchMedia && window.matchMedia('(max-width: 1023px)').matches;
    body.style.overflow = (isMobile || lockForSearch) ? 'hidden' : '';
    if (isSearch) { Search.resetFocus(); if (!searchInput || !searchInput.value.trim()) Search.renderEmpty(); }
  }

  document.querySelectorAll('[data-cbs-shop-trigger]').forEach(function(btn){
    btn.addEventListener('click', function(e){ e.preventDefault(); closeAll(nav.classList.contains('is-shop') ? null : 'shop'); });
  });
  document.querySelectorAll('[data-cbs-mobile-trigger]').forEach(function(btn){
    btn.addEventListener('click', function(e){ e.preventDefault(); closeAll(nav.classList.contains('is-mobile-open') ? null : 'mobile'); });
  });
  document.querySelectorAll('[data-cbs-mobile-close]').forEach(function(btn){
    btn.addEventListener('click', function(e){ e.preventDefault(); closeAll(null); });
  });
  // Mobile: the header search icon opens/closes search as a top overlay (reuses the search field + JS).
  document.querySelectorAll('[data-cbs-search-toggle]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      var opening = !nav.classList.contains('is-searching');
      closeAll(opening ? 'search' : null);
      if (opening && searchInput) { setTimeout(function(){ try { searchInput.focus(); } catch(_){} }, 80); }
    });
  });
  document.querySelectorAll('[data-cbs-msearch-close]').forEach(function(btn){
    btn.addEventListener('click', function(e){ e.preventDefault(); closeAll(null); });
  });

  var Search = (function(){
    var API = '/wp-json/cbs/v1/search?q=';
    var RECENT_KEY = 'cbs_recent_searches';
    var MAX_RECENT = 6;
    var POPULAR = ['whey','pre-workout','creatine','protein bars','mass gainer','BCAA'];
    var ctrl = null, debounce = null, focused = -1;
    function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    function getRecent(){ try { var r = localStorage.getItem(RECENT_KEY); return r ? JSON.parse(r) : []; } catch(_){ return []; } }
    function addRecent(q){ if (!q) return; var l = getRecent().filter(function(x){ return x !== q; }); l.unshift(q); l = l.slice(0, MAX_RECENT); try { localStorage.setItem(RECENT_KEY, JSON.stringify(l)); } catch(_){} }
    function clearRecent(){ try { localStorage.removeItem(RECENT_KEY); } catch(_){} renderEmpty(); }
    function chip(q, iconClass){ return '<button type="button" class="cbs-search__chip" data-cbs-suggest="'+esc(q)+'"><i class="ph-bold '+iconClass+'" aria-hidden="true"></i><span>'+esc(q)+'</span></button>'; }
    function renderEmpty(){
      if (!searchPanel) return;
      var recent = getRecent(); var html = '';
      if (recent.length) { html += '<div class="cbs-search__group"><div class="cbs-search__group-head"><span class="cbs-search__group-label">Recent</span><button type="button" class="cbs-search__group-clear" data-cbs-clear-recent>Clear</button></div><div class="cbs-search__chips">' + recent.map(function(q){ return chip(q, 'ph-clock-counter-clockwise'); }).join('') + '</div></div>'; }
      html += '<div class="cbs-search__group"><div class="cbs-search__group-head"><span class="cbs-search__group-label">Popular</span></div><div class="cbs-search__chips">' + POPULAR.map(function(q){ return chip(q, 'ph-fire'); }).join('') + '</div></div>';
      searchPanel.innerHTML = html;
    }
    function renderLoading(){ if (!searchPanel) return; searchPanel.innerHTML = '<div class="cbs-search__group"><div class="cbs-search__group-head"><span class="cbs-search__group-label">Searching…</span></div><div class="cbs-search__skeletons">' + Array.apply(null, {length:4}).map(function(){ return '<div class="cbs-search__skel"></div>'; }).join('') + '</div></div>'; }
    function renderResults(items, q){
      if (!searchPanel) return;
      if (!items || !items.length) { searchPanel.innerHTML = '<div class="cbs-search__empty"><i class="ph-bold ph-magnifying-glass" aria-hidden="true"></i><p>No matches for "<strong>'+esc(q)+'</strong>"</p><a class="cbs-search__empty-cta" href="' + cbsHomeShopUrl + '">Browse all products <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a></div>'; return; }
      var products = items.slice(0, 8);
      var html = '<div class="cbs-search__group"><div class="cbs-search__group-head"><span class="cbs-search__group-label">Products ('+products.length+')</span></div><div class="cbs-search__items">' +
        products.map(function(p, i){
          var img = p.image || '';
          var price = (p.price !== '' && p.price != null) ? '₹' + Math.round(p.price).toLocaleString('en-US') : '';
          var stock = (p.in_stock === false) ? '<span class="cbs-search__item-stock cbs-search__item-stock--out">Out of stock</span>' : '';
          return '<a class="cbs-search__item" href="'+p.permalink+'" data-cbs-search-result data-i="'+i+'"><span class="cbs-search__item-img">' + (img ? '<img src="'+img+'" alt="" loading="lazy">' : '') + '</span><span class="cbs-search__item-meta"><strong class="cbs-search__item-name">'+esc(p.name)+'</strong><span class="cbs-search__item-row">' + (price ? '<em class="cbs-search__item-price">'+price+'</em>' : '') + stock + '</span></span><i class="ph-bold ph-arrow-up-right cbs-search__item-arrow" aria-hidden="true"></i></a>';
        }).join('') +
      '</div><a class="cbs-search__see-all" href="' + cbsSearchUrl(q) + '">See all results for "'+esc(q)+'" <i class="ph-bold ph-arrow-right" aria-hidden="true"></i></a></div>';
      searchPanel.innerHTML = html;
    }
    function go(q){
      if (!q || q.length < 2) { renderEmpty(); return; }
      if (ctrl) ctrl.abort();
      ctrl = new AbortController();
      renderLoading();
      fetch(API + encodeURIComponent(q), { signal: ctrl.signal }).then(function(r){ return r.json(); }).then(function(items){ renderResults(items, q); }).catch(function(err){ if (err && err.name === 'AbortError') return; if (searchPanel) searchPanel.innerHTML = '<div class="cbs-search__empty"><p>Search unavailable. Try again in a moment.</p></div>'; });
    }
    function focusables(){ return searchPanel ? searchPanel.querySelectorAll('[data-cbs-search-result], [data-cbs-suggest]') : []; }
    function paintFocus(){ var items = focusables(); Array.prototype.forEach.call(items, function(it, i){ it.classList.toggle('is-focused', i === focused); }); if (focused >= 0 && items[focused] && items[focused].scrollIntoView) items[focused].scrollIntoView({ block: 'nearest' }); }
    function resetFocus(){ focused = -1; paintFocus(); }
    if (searchInput) {
      searchInput.addEventListener('focus', function(){ if (!nav.classList.contains('is-searching')) closeAll('search'); });
      searchInput.addEventListener('input', function(){ clearTimeout(debounce); var q = searchInput.value.trim(); resetFocus(); if (!q) { renderEmpty(); return; } debounce = setTimeout(function(){ go(q); }, 200); });
      searchInput.addEventListener('keydown', function(e){
        var items = focusables();
        if (e.key === 'ArrowDown') { e.preventDefault(); focused = Math.min(items.length - 1, focused + 1); paintFocus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); focused = Math.max(-1, focused - 1); paintFocus(); }
        else if (e.key === 'Enter') {
          if (focused >= 0 && items[focused]) { e.preventDefault(); var it = items[focused]; if (it.dataset.cbsSuggest) { searchInput.value = it.dataset.cbsSuggest; go(searchInput.value); } else if (it.href) { addRecent(searchInput.value.trim()); location.href = it.href; } }
          else if (searchInput.value.trim()) { addRecent(searchInput.value.trim()); }
        }
      });
    }
    if (searchPill && searchInput) { searchPill.addEventListener('click', function(){ if (!nav.classList.contains('is-searching')) closeAll('search'); searchInput.focus(); }); }
    if (searchPanel) {
      searchPanel.addEventListener('click', function(e){
        var t = e.target;
        var suggest = t.closest && t.closest('[data-cbs-suggest]');
        if (suggest) { var q = suggest.getAttribute('data-cbs-suggest'); if (searchInput) { searchInput.value = q; searchInput.focus(); } go(q); return; }
        var clr = t.closest && t.closest('[data-cbs-clear-recent]');
        if (clr) { clearRecent(); return; }
        var res = t.closest && t.closest('[data-cbs-search-result]');
        if (res) { if (searchInput) addRecent(searchInput.value.trim()); }
      });
    }
    var form = nav.querySelector('.cbs-nav__search');
    if (form) { form.addEventListener('submit', function(){ if (searchInput) addRecent(searchInput.value.trim()); }); }
    return { renderEmpty: renderEmpty, resetFocus: resetFocus };
  })();

  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { if (searchInput && document.activeElement === searchInput) searchInput.blur(); closeAll(null); return; }
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); closeAll('search'); if (searchInput) searchInput.focus(); }
  });

  document.addEventListener('click', function(e){
    var t = e.target; if (!t || !t.closest) return;
    if (nav.classList.contains('is-shop') && !t.closest('.cbs-nav')) closeAll(null);
    if (nav.classList.contains('is-searching') && !t.closest('.cbs-nav')) closeAll(null);
  });

  var cartBadge = nav.querySelector('[data-cbs-cart-count]');
  function setCart(n){ if (!cartBadge) return; n = parseInt(n, 10) || 0; cartBadge.textContent = n; cartBadge.classList.toggle('is-zero', n === 0); cartBadge.classList.add('is-pulsing'); setTimeout(function(){ cartBadge.classList.remove('is-pulsing'); }, 420); }
  if (window.jQuery) {
    jQuery(document.body).on('added_to_cart', function(){ setTimeout(function(){ setCart(cartBadge && cartBadge.textContent); }, 60); });
    jQuery(document.body).on('removed_from_cart wc_fragments_refreshed cart_page_refreshed', function(){ setTimeout(function(){ setCart(cartBadge && cartBadge.textContent); }, 60); });
  }
  document.addEventListener('cbs:cart:changed', function(e){ if (e && e.detail && typeof e.detail.count === 'number') setCart(e.detail.count); });

  var wishBadge = nav.querySelector('[data-cbs-wishlist-count]');
  function readWishCount(){ try { var r = localStorage.getItem('cbs_wishlist'); var l = r ? JSON.parse(r) : []; return Array.isArray(l) ? l.length : 0; } catch(_){ return 0; } }
  function setWish(n){ if (!wishBadge) return; n = parseInt(n, 10) || 0; wishBadge.textContent = n; wishBadge.classList.toggle('is-zero', n === 0); wishBadge.classList.add('is-pulsing'); setTimeout(function(){ wishBadge.classList.remove('is-pulsing'); }, 420); }
  setWish(readWishCount());
  function reReadFromMerged(){ setWish(readWishCount()); }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', function(){ setTimeout(reReadFromMerged, 350); }); } else { setTimeout(reReadFromMerged, 350); }
  window.addEventListener('cbs:wishlist-change', function(e){ var l = e && e.detail && e.detail.list; if (Array.isArray(l)) { setWish(l.length); return; } setWish(readWishCount()); });
})();
</script>

