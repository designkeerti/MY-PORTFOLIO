<script id="jquery-js-after">
jQuery(document).ready(function($) {
            console.log("Cart Block Fix Loaded");
            
            // Function to get real cart count
            function getCartCount() {
                if (document.cookie.indexOf("woocommerce_items_in_cart") === -1) { return; }
                $.ajax({
                    url: "https://crossbordersupps.com/wp-admin/admin-ajax.php",
                    type: "POST",
                    data: {
                        action: "get_block_cart_count",
                        nonce: "66f35e8bfc"
                    },
                    success: function(response) {
                        if (response.success) {
                            // Update ALL possible cart count elements
                            $(".cart-count").text(response.data.count);
                            $(".cart-contents-count").text(response.data.count);
                            
                            // Also update any element with cart count classes
                            $("*").each(function() {
                                if ($(this).text().match(/\d+/) && $(this).text().includes("Cart")) {
                                    // Update if it looks like cart count
                                }
                            });
                            
                            console.log("Cart count updated to: " + response.data.count);
                        }
                    }
                });
            }
            
            // For CART BLOCK - these are the events you need
            // Watch for cart block updates
            $(document.body).on("wc-blocks-cart-updated", function() {
                console.log("Cart block updated");
                getCartCount();
            });
            
            // Watch for quantity changes in cart block
            $(document).on("click", ".wc-block-cart-items__row .wc-block-components-quantity-selector__button", function() {
                console.log("Quantity button clicked");
                setTimeout(getCartCount, 1000);
                setTimeout(getCartCount, 2000);
            });
            
            // REMOVE ITEM DETECTION - for your specific "Remove item" button
            $(document).on("click", ".wc-block-cart-item__remove-link", function(e) {
                console.log("REMOVE ITEM CLICKED");
                
                // The block takes time to update, so check multiple times
                setTimeout(getCartCount, 500);   // Quick check
                setTimeout(getCartCount, 1000);  // After 1 second
                setTimeout(getCartCount, 2000);  // After 2 seconds
                setTimeout(getCartCount, 3000);  // After 3 seconds
            });
            
            // Also catch the remove via keyboard/accessibility
            $(document).on("keyup", ".wc-block-cart-item__remove-link", function(e) {
                if (e.keyCode === 13 || e.key === "Enter") {
                    console.log("Remove via keyboard");
                    setTimeout(getCartCount, 1000);
                    setTimeout(getCartCount, 2000);
                }
            });
            
            // Watch for any cart changes via block events
            if (window.wc && window.wc.wcBlocks) {
                // Cart block store updates
                $(document.body).on("wc-blocks-store", function() {
                    console.log("Store update");
                    getCartCount();
                });
            }
            
            // MutationObserver - watches for DOM changes (most reliable for blocks)
            var observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    // Check if cart items changed
                    if (mutation.target.className && 
                        (mutation.target.className.includes("cart-items") || 
                         mutation.target.className.includes("wc-block-cart"))) {
                        console.log("Cart DOM changed");
                        getCartCount();
                    }
                });
            });
            
            // Start observing when cart is present
            setTimeout(function() {
                var cartElement = document.querySelector(".wc-block-cart");
                if (cartElement) {
                    observer.observe(cartElement, {
                        childList: true,
                        subtree: true,
                        characterData: true
                    });
                    console.log("Observing cart changes");
                }
            }, 1000);
            
            // Force update every 2 seconds on cart page as backup
            if (window.location.href.includes("/cart")) {
                setInterval(getCartCount, 2000);
            }
            
            // Initial update
            getCartCount();
        });
    
//# sourceURL=jquery-js-after
</script>
