        <script type="text/javascript">
        (function($) {
            'use strict';
            
            // Initialize wishlist state with PHP data
            var wishlistState = {
                products: [].map(function(id) {
                    return id.toString();
                }),
                isInitialized: true
            };
            
            console.log('Initial wishlist state:', wishlistState.products);
            
            // Function to check if product is in wishlist
            function isInWishlist(productId) {
                return wishlistState.products.indexOf(productId.toString()) > -1;
            }
            
            // Function to update wishlist state
            function updateWishlistState(productId, action) {
                productId = productId.toString();
                
                if (action === 'add') {
                    if (wishlistState.products.indexOf(productId) === -1) {
                        wishlistState.products.push(productId);
                    }
                } else if (action === 'remove') {
                    var index = wishlistState.products.indexOf(productId);
                    if (index > -1) {
                        wishlistState.products.splice(index, 1);
                    }
                }
                
                console.log('Updated wishlist state:', wishlistState.products);
            }
            
            // Function to sync wishlist icons based on state
            function syncWishlistIcons() {
                console.log('Syncing wishlist icons...');
                
                $('.product-card').each(function() {
                    var $productCard = $(this);
                    var productId = $productCard.data('product-id');
                    
                    // If product card doesn't have data-product-id, try to find it from button
                    if (!productId) {
                        var $wishlistBtn = $productCard.find('.add_to_wishlist');
                        if ($wishlistBtn.length) {
                            productId = $wishlistBtn.data('product-id');
                            if (productId) {
                                $productCard.attr('data-product-id', productId);
                            }
                        }
                    }
                    
                    if (productId && wishlistState.isInitialized) {
                        var $wishlistBtn = $productCard.find('.add_to_wishlist');
                        if ($wishlistBtn.length) {
                            var $icon = $wishlistBtn.find('.yith-wcwl-icon');
                            var isInWishlistLocal = isInWishlist(productId);
                            
                            if (isInWishlistLocal && !$wishlistBtn.hasClass('added')) {
                                // Update to filled heart
                                $wishlistBtn.addClass('added');
                                if ($icon.length) {
                                    $icon.removeClass('fa-heart-o').addClass('fa-heart');
                                    $icon.css('color', '#ff4081');
                                }
                                $wishlistBtn.attr('title', 'Browse wishlist');
                                console.log('Updated wishlist icon for product:', productId, 'to filled heart');
                            } else if (!isInWishlistLocal && $wishlistBtn.hasClass('added')) {
                                // Update to empty heart
                                $wishlistBtn.removeClass('added');
                                if ($icon.length) {
                                    $icon.removeClass('fa-heart').addClass('fa-heart-o');
                                    $icon.css('color', '');
                                }
                                $wishlistBtn.attr('title', 'Add to wishlist');
                                console.log('Updated wishlist icon for product:', productId, 'to empty heart');
                            }
                        }
                    }
                });
            }
            
            // Initialize on document ready
            $(document).ready(function() {
                console.log('Document ready, syncing wishlist icons...');
                // Sync icons after a short delay to ensure DOM is ready
                setTimeout(function() {
                    syncWishlistIcons();
                }, 500);
            });
            
            // Also sync after AJAX loads (for filtered products)
            $(document).ajaxComplete(function(event, xhr, settings) {
                if (settings.url && settings.url.indexOf('admin-ajax.php') !== -1) {
                    if (settings.data && (settings.data.indexOf('get_apparels_products') !== -1 || 
                        settings.data.indexOf('get_bestsellers_products') !== -1)) {
                        setTimeout(function() {
                            console.log('AJAX complete, syncing wishlist icons...');
                            syncWishlistIcons();
                        }, 300);
                    }
                }
            });
            
            // Make functions available globally
            window.wishlistState = wishlistState;
            window.updateWishlistState = updateWishlistState;
            window.isInWishlist = isInWishlist;
            window.syncWishlistIcons = syncWishlistIcons;
            
        })(jQuery);
        </script>
